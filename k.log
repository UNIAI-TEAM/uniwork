$ cd "$(git rev-parse --show-toplevel)"; export GIT_INDEX_FILE=/tmp/pr10r1-shots.idx; rm -f $GIT_INDEX_FILE; n=0; for f in $(find /tmp/pr10r1-office-results -name "*.png" | sort); do name=$(echo "${f#/tmp/pr10r1-office-results/}" | tr "/" "_"); git update-index --add --cacheinfo 100644,$(git hash-object -w "$f"),"$name"; n=$((n+1)); done; echo "SHOTS=$n"; t=$(git write-tree); c=$(echo "pr10-repin-1101 r1 office screenshots at $(git rev-parse --short HEAD)" | git commit-tree $t); git push -q origin $c:refs/test-results/pr10-repin-1101/shots-r1 2>&1 | tail -2; rc=${PIPESTATUS[0]}; git ls-tree --name-only $c | head -80; unset GIT_INDEX_FILE; echo; echo "SHOTS_PUSH_EXIT=$rc"
SHOTS=0

SHOTS_PUSH_EXIT=0
