# Applies to every editor that reads EditorConfig. The values here are not a
# preference — they are what gofmt, prettier-less TypeScript and the Makefile
# already produce, written down so a new editor does not fight them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# gofmt emits tabs. An editor set to spaces makes every Go file a diff.
[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# A line ending in two spaces is a hard break in Markdown; trimming it silently
# reflows the paragraph.
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_size = 2

# Kotlin (apps/chat-mobile/modules/*/android): ktlint reads these
# (mobile-verify.yml › android-release). Android's own style at the repo's
# two-space indent; lines up to 160, as the module's comments run long. An
# expression body may start on the line after its signature when that reads
# better (function-signature would force it up).
[*.{kt,kts}]
ktlint_code_style = android_studio
max_line_length = 160
ktlint_standard_function-signature = disabled
