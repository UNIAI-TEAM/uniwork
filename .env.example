# UniWork — local development environment.
# Copy to .env (main checkout) or run `make worktree-env` (git worktree).
# Every variable the server or the scripts read is listed here; anything not
# listed is not a knob.

# ==================== Database ====================
# The shared PostgreSQL container from docker-compose.yml. Each checkout gets
# its own database on it (POSTGRES_DB); worktrees get a unique name.
POSTGRES_DB=uniwork
POSTGRES_USER=uniwork
POSTGRES_PASSWORD=uniwork
# Host port for the Docker Postgres. Change this (and DATABASE_URL) if
# something else already owns 5432 — e.g. a Windows PostgreSQL install.
POSTGRES_PORT=5432
DATABASE_URL=postgres://uniwork:uniwork@localhost:5432/uniwork?sslmode=disable
# Go tests truncate every table, so they use a separate database on the same
# Postgres instance (ensure-postgres creates ${POSTGRES_DB}_test). scripts/
# local-env.sh derives this from DATABASE_URL; you rarely need to set it.
# TEST_DATABASE_URL=postgres://uniwork:uniwork@localhost:5432/uniwork_test?sslmode=disable

# ==================== Server ====================
PORT=8080
# HS256 secret for access tokens. Change it outside local dev. It also keys
# the AES-GCM seal on users.totp_secret: rotating it voids every MFA enrolment
# (spec F-01 §2 I2), so plan a re-enrol notice with the rotation.
JWT_SECRET=dev-secret-change-me
# Origin allowed by CORS and by the WebSocket origin check. Must be absolute;
# an https scheme also turns on the Secure flag of the refresh cookie.
FRONTEND_ORIGIN=http://localhost:3000
# Optional, comma-separated: extra origins the WebSocket handshake accepts
# beyond FRONTEND_ORIGIN (a second host serving the same app). CORS is not
# widened by this.
ALLOWED_ORIGINS=
# Comma-separated CIDRs whose X-Forwarded-For is trusted by the rate limiter
# and the WebSocket origin check. Empty = trust no proxy.
TRUSTED_PROXIES=
# debug | info | warn | error (default debug)
LOG_LEVEL=
# json in production (one object per line, trace_id on every request line);
# anything else is tint text for a terminal.
LOG_FORMAT=

# Serves Swagger UI at /swagger/index.html. Defaults on for localhost
# FRONTEND_ORIGIN; set 0/false to disable. Leave unset in production.
ENABLE_SWAGGER=true

# ==================== App ====================
# development (default) | production. production turns DEV_VERIFICATION_CODE off.
APP_ENV=development
# Six digits accepted in place of the mailed verification code while
# APP_ENV is not production. Local runs and the e2e suite verify with it.
DEV_VERIFICATION_CODE=123456
# Origin browsers reach the API on. Builds the Google redirect URI
# (${API_PUBLIC_URL}/api/v1/auth/google/callback), which must be registered
# byte for byte in the Google Cloud console.
API_PUBLIC_URL=http://localhost:8080

# ==================== Email ====================
# Web Push (F-07). Generate a pair once: `npx web-push generate-vapid-keys`.
# Both empty turns push off: the API answers enabled=false and the client
# hides the option. VAPID_SUBJECT defaults to FRONTEND_ORIGIN.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Empty SMTP_HOST prints every message (and verification code) to the log.
# Mail đi qua bảng emails và một worker trong process (retry 5 lần, backoff
# 1m→6h). Với SMTP_HOST trống, worker in mail ra log ngay sau khi ghi.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (default) | implicit; port 465 implies implicit.
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=
# Display sender used for every mail kind (verification, invite, reset, welcome).
MAIL_FROM=UniWork <noreply@unicomhub.com>

# ==================== Billing ====================
# manual (default) | stripe. manual answers 503 on checkout (F-02).
BILLING_PROVIDER=manual

# ==================== Email Hub (IMAP) ====================
# Base64-encoded 32-byte AES key for sealing App Passwords at rest.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# Empty disables connect; list/read still work for rows already synced.
EMAIL_HUB_CREDENTIAL_KEY=

# ==================== Google sign-in ====================
# Both required to enable the button; either missing keeps Google off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==================== Connected calendars ====================
# Uses GOOGLE_CLIENT_ID/SECRET above for Google Calendar. Register callback:
# API_PUBLIC_URL/api/v1/calendar-connections/google/callback
# Outlook uses a multi-tenant Microsoft Entra web app. Register callback:
# API_PUBLIC_URL/api/v1/calendar-connections/outlook/callback
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Base64-encoded 32-byte AES key for OAuth access/refresh tokens at rest.
CALENDAR_CREDENTIAL_KEY=

# ==================== Realtime & Redis ====================
# Optional. With it set: the rate limiter is enabled, the realtime relay
# writes every event to Redis Streams so several API nodes deliver each
# other's events, and workspace membership is cached. Without it everything
# runs in-process on one node.
REDIS_URL=redis://localhost:6379
# Used only by tests (rate limit, membership cache); they skip when unset.
REDIS_TEST_URL=redis://localhost:6379/15

# ==================== Storage ====================
# FileService storage (server/internal/storage/config.go, wired in
# cmd/server/main.go). STORAGE_BACKEND picks where NEW files are written:
# minio | s3 | local. It is trimmed and lowercased; unset selects minio; set
# but empty is a startup error. Every group declared below is built and
# preflighted at startup even when it is not selected, and a bad group stops
# the server - there is no fallback to local disk. Rows written before a
# module's cutover are still read from the destination their writer used.
#
# Local disk must be chosen explicitly (STORAGE_BACKEND=local plus
# LOCAL_UPLOAD_DIR; a relative path resolves against the server's working
# directory); it also serves /uploads/* for legacy local objects. LOCAL_UPLOAD_BASE_URL alone does not declare the local group.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./data/uploads
LOCAL_UPLOAD_BASE_URL=http://localhost:8080

# MinIO (the default backend): every value is required and MinIO never falls
# back to the AWS_* credentials or to sample values. Local MinIO: `make
# minio-up` (docker-compose.minio.yml), then:
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_BUCKET=uniwork
# MINIO_ACCESS_KEY_ID=minioadmin
# MINIO_SECRET_ACCESS_KEY=minioadmin
# MINIO_REGION=us-east-1
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_REGION=
# Optional browser-facing endpoint used when presigning objects; leave empty
# when media is served through an authenticated proxy.
MINIO_PUBLIC_ENDPOINT=

# Amazon S3: S3_BUCKET declares the group (bucket name only, never a host).
# AWS_* credentials alone do not - they are shared with other services. Leave
# the key pair empty to use the IAM/instance credential chain; set one half
# and startup fails.
S3_BUCKET=
S3_REGION=
# Optional root folder for every object key, e.g. "production/" or "dev/".
S3_KEY_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: session token for temporary static credentials (AWS_STS). The
# storage config loader requires it only together with the pair above.
AWS_SESSION_TOKEN=
# Optional S3-compatible endpoint for the s3 group.
AWS_ENDPOINT_URL=
# Aliases that are never read for storage: set to anything other than
# S3_BUCKET / S3_REGION they are a startup error (storage_config_invalid).
AWS_S3_BUCKET=
AWS_REGION=
# Legacy S3 reads (pre-cutover rows): CDN host for their public URLs.
CLOUDFRONT_DOMAIN=

# ==================== Metrics ====================
# Set to expose Prometheus metrics on a separate listener, e.g. 127.0.0.1:9090.
# Empty disables metrics entirely.
METRICS_ADDR=

# ==================== Tracing (OpenTelemetry) ====================
# OTLP/gRPC collector, e.g. http://localhost:4317. Empty = spans are created
# (every response still carries X-Trace-Id) but never exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=uniwork-api
# Parent-based sampling ratio 0..1. Empty = 1.0 (OPEN_QUESTIONS O3: 100% until
# more than five tenants). X-Debug-Trace: 1 forces a sample.
OTEL_TRACES_SAMPLER_ARG=

# ==================== RUM & admin ====================
# Share of web sessions that post web-vitals to /api/v1/rum (0..1, default 0.2).
RUM_SAMPLE_RATE=0.2
# Per-IP budget for /api/v1/admin/* (default 60/min).
ADMIN_RATE_LIMIT_PER_MIN=60

# ==================== Feature flags ====================
# Path to a YAML flag file (see server/pkg/featureflag/config.go). Empty =
# no service; every flag evaluates to its default.
FEATURE_FLAGS_FILE=

# ==================== Video (LiveKit) ====================
# Local: `make start` / `make dev` starts docker-compose.livekit.yml and streams
# its logs. Leave these blank to use the same defaults, or set SKIP_LIVEKIT=1 to
# skip the container. Cloud: https://cloud.livekit.io (non-localhost URL skips Docker).
# Values must match livekit.dev.yaml when using the local container:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_must_be_at_least_32_chars
# Join JWT lifetime. Short on purpose: the client re-calls POST .../join after reconnect.
LIVEKIT_TOKEN_TTL=2m
# Leave unset (0) so LiveKit does not auto-close rooms; UniWork EndMeeting owns lifecycle.
# Set explicitly (e.g. 5m) only if you want provider-side empty-room cleanup.
# LIVEKIT_ROOM_EMPTY_TIMEOUT=0
LIVEKIT_ROOM_DEPARTURE_TIMEOUT=20s
# Conference provider key stored on meeting_conference_sessions.
MEETING_PROVIDER=livekit
# Outbox + webhook worker tuning (defaults shown).
# MEETING_WORKER_TICK=1s
# MEETING_OUTBOX_BATCH=50
# MEETING_WEBHOOK_BATCH=50
# MEETING_WEBHOOK_CONCURRENCY=8

# ==================== Frontend ====================
# Inlined at build time by Next.js and read ONLY in apps/web/platform/runtime-config.ts.
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max concurrent chat:{roomId} WebSocket subscriptions per client (lazy sidebar).
NEXT_PUBLIC_CHAT_SCOPE_LIMIT=25

# ==================== Chat media (GIF) ====================
# Tenor API key from https://developers.google.com/tenor — enables GIF + illustrated
# sticker search in chat. Empty uses GIF fallback only; emoji sticker packs remain.
TENOR_API_KEY=

# ==================== E2E ====================
# Where Playwright points; `make check` starts the app there if nothing is running.
E2E_BASE_URL=http://localhost:3000

# ==================== AI gateway (F-09) & recording ====================
# One gateway serves "Tóm tắt AI" on meetings and Ask UNI (⌘J). AI_PROVIDER
# picks the vendor: anthropic | openai | ollama | fake. Empty infers it from
# whichever credential is set (Anthropic first); none at all hides every AI
# feature. `fake` answers deterministically without network — use it for
# local development and E2E. See docs/ops/RUNBOOK_AI.md.
AI_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# OpenAI-compatible: OpenAI, Gemini's OpenAI endpoint, vLLM — change BASE_URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Ollama local/on-prem, no key.
OLLAMA_BASE_URL=
# Per-capability override, must be in the allowlist (server/internal/ai/policy.go);
# AI_MODEL_ALLOW extends the allowlist for self-hosted names (comma-separated).
# AI_MODEL_COPILOT_ANSWER=claude-sonnet-5
AI_MODEL_ALLOW=
AI_TIMEOUT_SECONDS=60
# LIVEKIT_RECORDING_BUCKET enables room recording through LiveKit Egress.
# Egress writes the object FileService registered, so this must equal the
# FileService bucket (MINIO_BUCKET or S3_BUCKET of the selected
# STORAGE_BACKEND) and Egress uses that group's credentials; any other bucket,
# or STORAGE_BACKEND=local, is a startup error. `make start` / ensure-livekit.sh
# also starts docker-compose.livekit.yml `egress` (and local MinIO for minio).
# LIVEKIT_RECORDING_BUCKET=uniwork
# LIVEKIT_RECORDING_S3_ENDPOINT overrides only the host Egress uploads to. When
# Egress runs in Docker and MinIO is on the host, set:
# LIVEKIT_RECORDING_S3_ENDPOINT=http://host.docker.internal:9000
# Leave empty to use MINIO_ENDPOINT / AWS_ENDPOINT_URL of the selected group.
LIVEKIT_RECORDING_BUCKET=
LIVEKIT_RECORDING_S3_ENDPOINT=
# MEETING_STT_AGENT_SECRET enables POST /meetings/{id}/transcript/agent for a
# LiveKit Agents worker (header X-Meeting-Agent-Secret). Empty = client Web Speech only.
MEETING_STT_AGENT_SECRET=

# --- Office engine service (G2-02) ---------------------------------------
# Private engine service Go calls for Office jobs (apps/office-engine; compose
# profile "office"). Unset OFFICE_ENGINE_URL = no engine: office jobs are
# refused, everything else (Documents list/download included) is unaffected.
# The engine needs the SAME two secrets; they must differ and be >= 32 chars.
# OFFICE_ENGINE_URL=http://127.0.0.1:8090
OFFICE_ENGINE_URL=
OFFICE_ENGINE_SERVICE_TOKEN=
OFFICE_ENGINE_GRANT_KEY=
# One HTTP call to the engine (not a job), default 10000.
# OFFICE_ENGINE_REQUEST_TIMEOUT_MS=10000
# Longest deadline a job may ask for, default 120000.
# OFFICE_JOB_MAX_DEADLINE_MS=120000
# How often the reconciler sweeps live jobs and probes the engine, default 5000.
# OFFICE_JOB_RECONCILE_INTERVAL_MS=5000
# Engine-side (compose profile "office"): per-job uid sandbox. The image already
# sets OFFICE_ENGINE_SANDBOX=required; only override for a dev container.
# OFFICE_ENGINE_SANDBOX=auto|required|off
# OFFICE_ENGINE_WORKER_UID_BASE=60100  # per-slot uid pool, one per worker slot
# OFFICE_ENGINE_WORKER_GID_BASE=60100
