+    /// A producer that writes the worksheet with a prefixed SpreadsheetML
+    /// namespace (`<x:worksheet xmlns:x=…>`) hits the same IronCalc import
+    /// limit, so its width-less `<x:col>` is filled too and the package
+    /// recalculates; the source package stays byte-identical.
+    #[test]
+    fn recalculates_a_prefixed_package_with_widthless_columns() {
+        for cols in [
+            "<x:cols><x:col min=\"2\" max=\"3\" outlineLevel=\"1\"/></x:cols>",
+            "<x:cols><x:col min=\"2\" max=\"2\" hidden=\"1\"/><x:col min=\"4\" max=\"4\" width=\"12\" customWidth=\"1\"/></x:cols>",
+            "<x:cols><x:col min=\"1\" max=\"1\" style=\"0\" collapsed=\"1\"></x:col></x:cols>",
+        ] {
+            let dir = tempfile::tempdir().unwrap();
+            let path = dir.path().join("prefixed.xlsx");
+            fixture(&path);
+            with_sheet_xml(&path, |_| prefixed_sheet_xml(cols));
+            let raw = std::fs::read(&path).unwrap();
+            let mut cache = RecalcCache::new();
+            let result = recalc_cells(&mut cache, &path, &[edit("A1", "100")], &[read_a1_a3()])
+                .unwrap_or_else(|error| panic!("{cols}: {error:?}"));
+            let sum = result.cells.iter().find(|cell| cell.row == 2).unwrap();
+            assert_eq!(sum.formatted, "120", "{cols}");
+            assert_eq!(std::fs::read(&path).unwrap(), raw, "{cols}");
+        }
+    }
+
+    fn prefixed_sheet_xml(cols: &str) -> String {
+        format!(
+            "<?xml version=\"1.0\" encoding=\"UTF-8\"?><x:worksheet xmlns:x=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><x:sheetFormatPr defaultColWidth=\"11\" defaultRowHeight=\"15\"/>{cols}<x:sheetData><x:row r=\"1\"><x:c r=\"A1\"><x:v>10</x:v></x:c></x:row><x:row r=\"2\"><x:c r=\"A2\"><x:v>20</x:v></x:c></x:row><x:row r=\"3\"><x:c r=\"A3\"><x:f>SUM(A1:A2)</x:f><x:v>30</x:v></x:c></x:row></x:sheetData></x:worksheet>"
+        )
+    }
+
