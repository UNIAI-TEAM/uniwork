+/// The next start tag at or after `from` whose local name is `local`, with the
+/// namespace prefix it is written with (`""`, or `"x:"` including the colon).
+/// Matching on the local name covers prefixed writers, as `table_styles.rs` does;
+/// the whole name must match, so `<colBreaks>` and `<cols>` are never `col`.
+fn find_start_tag<'a>(text: &'a str, local: &str, from: usize) -> Option<(usize, &'a str)> {
+    let mut at = from;
+    while let Some(offset) = text[at..].find('<') {
+        let start = at + offset;
+        let name_start = start + 1;
+        let name_len = text[name_start..]
+            .find(|ch: char| ch.is_whitespace() || ch == '>' || ch == '/')
+            .unwrap_or(text.len() - name_start);
+        let name = &text[name_start..name_start + name_len];
+        if let Some(prefix) = name.strip_suffix(local) {
+            if is_namespace_prefix(prefix) {
+                return Some((start, prefix));
+            }
+        }
+        at = name_start;
+    }
+    None
+}
+
+/// `""`, or an XML name followed by a colon (`"x:"`).
+fn is_namespace_prefix(prefix: &str) -> bool {
+    match prefix.strip_suffix(':') {
+        None => prefix.is_empty(),
+        Some(name) => {
+            !name.is_empty()
+                && name
+                    .chars()
+                    .all(|ch| ch.is_alphanumeric() || matches!(ch, '_' | '-' | '.'))
+        }
+    }
+}
