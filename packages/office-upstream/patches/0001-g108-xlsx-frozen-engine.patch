+// UNI-667 XLSX edit/save feature: regression test for the cellXfs dedupe fix.
+//
+// The defect this pins: the renderer's save body always carries the cell's CURRENT
+// style, so editing an already-bold cell re-sends style:{bold:true}. The gateway's
+// resolveStyle rebuilt the base xf into a canonical full-attribute form and interned
+// it with a raw string match, which never equalled the authored compact xf, so a
+// semantically redundant cellXfs entry was appended. The saved xl/styles.xml then
+// grew (fixture 364 B -> 431 B) and the independent output oracle correctly failed
+// nonTargetStructurePreserved.
+//
+// Every case here drives the REAL StylesheetEditor, so a fix that merely special-cases
+// one spelling cannot pass.
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { StylesheetEditor } from './xlsx-styles.ts'
+
+/// The authored compact stylesheet that mirrors the pinned lab fixture: cellXfs[1] is
+/// bold and spells ONLY fontId + applyFont, with the numeric defaults elided.
+const AUTHORED = [
+  '<?xml version="1.0" encoding="UTF-8"?>',
+  '<styleSheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main">',
+  '  <fonts count="2"><font/><font><b/></font></fonts><fills count="1"><fill/></fills><borders count="1"><border/></borders>',
+  '  <cellStyleXfs count="1"><xf/></cellStyleXfs><cellXfs count="2"><xf/><xf fontId="1" applyFont="1"/></cellXfs>',
+  '</styleSheet>',
+].join('\n')
+
+const cellXfsCount = (editor: StylesheetEditor): number => {
+  const match = /<cellXfs count="(\d+)">/.exec(editor.serialize())
+  assert.notEqual(match, null, 'serialized stylesheet keeps a cellXfs section')
+  return Number(match![1])
+}
+
+test('restating the base format reuses its index instead of appending a duplicate', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  // base index 1 is already bold. A delta that only restates "bold" is a no-op.
+  const index = editor.resolveStyle(1, { bold: true })
+  assert.equal(index, 1, 'the identical format must resolve back to its own cellXfs index')
+  assert.equal(cellXfsCount(editor), 2, 'cellXfs must not grow')
+  assert.equal(editor.changed, false, 'a no-op delta leaves the stylesheet unchanged')
+  assert.equal(editor.serialize(), AUTHORED, 'a no-op delta must not reserialize styles.xml at all')
+})
+
+test('inverting a boolean to its base value reuses the index', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  // base 1 is bold; explicitly asking for non-bold then bold again lands on the base.
+  const notBold = editor.resolveStyle(1, { bold: false })
+  assert.notEqual(notBold, 1, 'clearing bold is a genuinely different format')
+  const backToBold = editor.resolveStyle(notBold, { bold: true })
+  assert.equal(backToBold, 1, 'bold without italic/other deltas is the base format again')
+})
+
+test('a genuinely new format still appends exactly one entry', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  const italic = editor.resolveStyle(1, { italic: true })
+  assert.notEqual(italic, 1, 'italic is a different format from bold-only')
+  assert.equal(cellXfsCount(editor), 3, 'one new format appends exactly one entry')
+  assert.equal(editor.changed, true, 'a real format change is reported')
+  // Repeating the SAME real delta must be idempotent, not additive.
+  assert.equal(editor.resolveStyle(1, { italic: true }), italic, 'the same delta resolves to the same index')
+  assert.equal(cellXfsCount(editor), 3, 'repeating a real delta must not append again')
+})
+
+test('repeated saves never grow cellXfs', () => {
+  let editor = new StylesheetEditor(AUTHORED)
+  for (let round = 0; round < 5; round += 1) {
+    // Each round: restate bold (no-op), then apply a real italic delta on the base.
+    assert.equal(editor.resolveStyle(1, { bold: true }), 1, 'round ' + round + ': no-op restated bold reuses base')
+    const italic = editor.resolveStyle(1, { italic: true })
+    assert.equal(editor.resolveStyle(1, { italic: true }), italic, 'round ' + round + ': repeated italic is stable')
+  }
+  assert.equal(cellXfsCount(editor), 3, 'the whole sequence yields exactly one extra format')
+})
+
+test('distinct numeric formats and alignment still create distinct entries', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  const percent = editor.resolveStyle(0, { numberFormat: '0%' })
+  const currency = editor.resolveStyle(0, { numberFormat: '#,##0.00' })
+  const wrapped = editor.resolveStyle(0, { wrapText: true })
+  assert.equal(new Set([0, percent, currency, wrapped]).size, 4, 'each distinct format gets its own index')
+  assert.equal(cellXfsCount(editor), 5, 'four new formats append four entries')
+  // Re-resolving each of them reuses its own index.
+  assert.equal(editor.resolveStyle(0, { numberFormat: '0%' }), percent, 'percent reuses its index')
+  assert.equal(editor.resolveStyle(0, { numberFormat: '#,##0.00' }), currency, 'currency reuses its index')
+  assert.equal(editor.resolveStyle(0, { wrapText: true }), wrapped, 'wrap reuses its index')
+  assert.equal(cellXfsCount(editor), 5, 'no further growth on re-resolve')
+})
+
+test('a no-op restatement of the base format never appends, on a styled base too', () => {
+  // The defect case the renderer actually drives: the base cell is ALREADY bold and the
+  // save body re-sends style:{bold:true}. buildFont reproduces the base font verbatim
+  // here, so the xf identity equals the base and the index is reused.
+  const editor = new StylesheetEditor(AUTHORED)
+  const before = cellXfsCount(editor)
+  assert.equal(editor.resolveStyle(1, { bold: true }), 1, 'bold on an already-bold base reuses index 1')
+  assert.equal(editor.resolveStyle(1, { bold: true }), 1, 'and again')
+  assert.equal(cellXfsCount(editor), before, 'repeated no-op saves never grow cellXfs')
+})
+
+test('re-resolving an identical richer delta is stable, and the font-order boundary is named', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  // Base 1 is bold. Adding italic builds <i/><b/>: buildFont prepends the overridden
+  // children, so the resulting font markup is order-distinct from the authored <b/>.
+  const italicFromBold = editor.resolveStyle(1, { italic: true })
+  assert.notEqual(italicFromBold, 1, 'bold+italic is a different format from bold')
+  const afterFirst = cellXfsCount(editor)
+  assert.equal(afterFirst, 3, 'exactly one new xf for the new format')
+
+  // The same delta resolved against its OWN result builds <b/><i/> - a different font
+  // STRING for the same rendered format, because the fonts list is interned by exact
+  // markup. That is pre-existing upstream behaviour and this fix does not change it, so
+  // it is asserted here rather than glossed over: one extra entry, not a runaway.
+  const restated = editor.resolveStyle(italicFromBold, { bold: true, italic: true })
+  assert.notEqual(restated, italicFromBold, 'font markup order is still part of the byte-level font identity')
+  assert.equal(cellXfsCount(editor), 4, 'the reordered font costs exactly one entry')
+
+  // The xf-level guarantee still holds: resolving the SAME delta against the SAME base
+  // index is idempotent and adds nothing further, however many times it runs.
+  for (let round = 0; round < 5; round += 1) {
+    assert.equal(
+      editor.resolveStyle(italicFromBold, { bold: true, italic: true }),
+      restated,
+      'round ' + round + ': the identical delta reuses the index it first produced',
+    )
+  }
+  assert.equal(cellXfsCount(editor), 4, 'repeating it never appends')
+
+  // And the no-op restatement of the ORIGINAL authored base - the real renderer case -
+  // still never appends.
+  assert.equal(editor.resolveStyle(1, { bold: true }), 1, 'authored bold base restated reuses index 1')
+  assert.equal(cellXfsCount(editor), 4, 'still no growth')
+})
+
+test('alignment and protection children are part of the format identity', () => {
+  const editor = new StylesheetEditor(AUTHORED)
+  const left = editor.resolveStyle(0, { horizontalAlignment: 'left' })
+  const center = editor.resolveStyle(0, { horizontalAlignment: 'center' })
+  assert.notEqual(left, center, 'a different alignment is a different format')
+  assert.equal(editor.resolveStyle(0, { horizontalAlignment: 'left' }), left, 'the same alignment reuses its index')
+})
+
+test('an xf carrying applyAlignment is not confused with a bare alignment carrier', () => {
+  // A base that applies an alignment must not collapse into one that merely inherits it.
+  const withAlignment = AUTHORED.replace(
+    '<cellXfs count="2"><xf/><xf fontId="1" applyFont="1"/></cellXfs>',
+    '<cellXfs count="3"><xf/><xf fontId="1" applyFont="1"/><xf applyAlignment="1"><alignment horizontal="center"/></xf></cellXfs>',
+  )
+  const editor = new StylesheetEditor(withAlignment)
+  const alignCenter = editor.resolveStyle(2, { horizontalAlignment: 'center' })
+  assert.equal(alignCenter, 2, 'restating the base alignment reuses index 2')
+  assert.equal(cellXfsCount(editor), 3, 'no growth')
+  // A different alignment on that base is genuinely new.
+  const alignRight = editor.resolveStyle(2, { horizontalAlignment: 'right' })
+  assert.notEqual(alignRight, 2, 'a different alignment appends')
+})
