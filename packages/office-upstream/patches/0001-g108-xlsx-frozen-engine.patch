+/// Normalises one boolean attribute spelling so "1" and "true" compare equal.
+function normalizedBooleanAttribute(xfXml: string, name: string): string {
+  const value = readCoreAttribute(xfXml, name)
+  if (value === undefined) return ''
+  return value === '1' || value === 'true' ? '1' : value === '0' || value === 'false' ? '0' : value
+}
+
+/// The canonical cell-FORMAT identity of one CT_Xf: the attributes that select the
+/// rendered format, with the OOXML defaults (numFmtId/fontId/fillId/borderId = 0)
+/// filled in for an omitted attribute, plus the alignment/protection children
+/// reduced to their markup.
+///
+/// A cellXfs entry is a format, not a spelling. The authored compact form
+/// `<xf fontId="1" applyFont="1"/>` and the reserialised
+/// `<xf numFmtId="0" fontId="1" fillId="0" borderId="0" applyFont="1"/>` denote the
+/// SAME format; attribute order and elided defaults carry no meaning. Raw string
+/// equality cannot see that, so interning a rebuilt xf by text alone appends a
+/// redundant duplicate whenever a delta merely restates the base format - the
+/// unbounded-growth defect. Comparing this identity instead keeps exactly one index
+/// per distinct format.
+function xfIdentity(xfXml: string): string {
+  const number = (name: string): number => {
+    const value = readAttribute(xfXml, name)
+    return value === undefined ? 0 : Number(value)
+  }
+  const children = (/<xf\b[^>]*>([\s\S]*?)<\/xf>/.exec(xfXml)?.[1] ?? '').replace(/\s+/g, '')
+  const core = [
+    'numFmtId=' + number('numFmtId'),
+    'fontId=' + number('fontId'),
+    'fillId=' + number('fillId'),
+    'borderId=' + number('borderId'),
+    'xfId=' + (readCoreAttribute(xfXml, 'xfId') ?? ''),
+    ...XF_APPLY_ATTRIBUTES.map((name) => name + '=' + normalizedBooleanAttribute(xfXml, name)),
+  ]
+  return core.join('|') + '#' + children
+}
