+/// IronCalc 0.7.1 rejects a few otherwise valid producer shapes: indentation
+/// text nodes between worksheet rows, a style table with no `cellStyles`
+/// entry, and `cellXfs` entries that omit their default `xfId`. The gateway
+/// must retain the source archive exactly, so only a throwaway archive used
+/// for the resident model is normalized here.
+fn load_recalc_model(path: &Path, path_text: &str) -> Result<Model<'static>, SidecarError> {
+    // Excel-produced workbooks import as they are; the compatibility rewrite is
+    // a fallback so the common path keeps one import and no extra archive.
+    let direct = catch_unwind(AssertUnwindSafe(|| {
+        load_from_xlsx(path_text, "en", "UTC", "en")
+    }));
+    // A rejection is not only an Err: IronCalc's strict importer can PANIC on
+    // the same producer shapes (its own note above names missing cellStyles
+    // and whitespace nodes). Contain that panic here and treat it as a
+    // rejection, so the compatibility rewrite below — the only thing that can
+    // read those shapes — still runs. Retaining the payload means a workbook
+    // the rewrite cannot help still surfaces the importer's own failure.
+    let mut direct_panic = None;
+    match direct {
+        Ok(Ok(model)) => return Ok(model),
+        Ok(Err(_)) => {}
+        Err(panic) => direct_panic = Some(panic),
+    }
+    let normalized = normalize_for_ironcalc(path)?;
+    let Some(normalized) = normalized else {
+        if let Some(panic) = direct_panic {
+            std::panic::resume_unwind(panic);
+        }
+        return Err(SidecarError::Workbook(
+            "Formula engine import failed: no compatible representation.".into(),
+        ));
+    };
+    let import_path = normalized
+        .to_str()
+        .unwrap_or(path_text);
+    let imported = catch_unwind(AssertUnwindSafe(|| {
+        load_from_xlsx(import_path, "en", "UTC", "en")
+    }));
+    let _ = std::fs::remove_file(&normalized);
+    match imported {
+        Ok(result) => result.map_err(|error| {
+            SidecarError::Workbook(format!("Formula engine import failed: {error}"))
+        }),
+        Err(panic) => std::panic::resume_unwind(panic),
+    }
+}
+
+fn normalize_for_ironcalc(path: &Path) -> Result<Option<PathBuf>, SidecarError> {
+    let mut archive = ZipArchive::new(File::open(path)?)?;
+    let mut replacements: HashMap<usize, Vec<u8>> = HashMap::new();
+    for index in 0..archive.len() {
+        let (name, bytes) = {
+            let mut entry = archive.by_index(index)?;
+            let name = entry.name().to_owned();
+            let is_worksheet = name.starts_with("xl/worksheets/") && name.ends_with(".xml");
+            if !is_worksheet && name != "xl/styles.xml" {
+                continue;
+            }
+            let mut bytes = Vec::new();
+            entry.read_to_end(&mut bytes)?;
+            (name, bytes)
+        };
+        let replacement = if name == "xl/styles.xml" {
+            normalize_styles_xml(&bytes)
+        } else {
+            compact_sheet_data_xml(&bytes)
+        };
+        if replacement != bytes {
+            replacements.insert(index, replacement);
+        }
+    }
+    if replacements.is_empty() {
+        return Ok(None);
+    }
+
+    let target = std::env::temp_dir().join(format!("genspark-ai-recalc-{}.xlsx", Uuid::new_v4()));
+    let mut writer = ZipWriter::new(File::create(&target)?);
+    for index in 0..archive.len() {
+        let name = archive.by_index(index)?.name().to_owned();
+        if let Some(bytes) = replacements.get(&index) {
+            let options = SimpleFileOptions::default()
+                .compression_method(CompressionMethod::Deflated)
+                .large_file(bytes.len() as u64 >= u64::from(u32::MAX));
+            writer.start_file(name, options)?;
+            writer.write_all(bytes)?;
+        } else {
+            writer.raw_copy_file_rename(archive.by_index_raw(index)?, &name)?;
+        }
+    }
+    writer.finish()?.sync_all()?;
+    Ok(Some(target))
+}
+
+/// Drop only indentation nodes inside `<sheetData>`, retaining literal spaces
+/// in inline and shared strings. IronCalc otherwise reads an indentation node
+/// as a row and rejects it because it carries no `r` attribute.
+fn compact_sheet_data_xml(source: &[u8]) -> Vec<u8> {
+    let Ok(source) = std::str::from_utf8(source) else {
+        return source.to_vec();
+    };
+    let mut output = String::with_capacity(source.len());
+    let mut cursor = 0;
+    let mut in_sheet_data = false;
+    let mut text_depth = 0usize;
+    while cursor < source.len() {
+        let Some(offset) = source[cursor..].find('<') else {
+            output.push_str(&source[cursor..]);
+            break;
+        };
+        let tag_start = cursor + offset;
+        let text = &source[cursor..tag_start];
+        if !in_sheet_data || text_depth > 0 || !text.chars().all(char::is_whitespace) {
+            output.push_str(text);
+        }
+        let Some(end_offset) = source[tag_start..].find('>') else {
+            output.push_str(&source[tag_start..]);
+            break;
+        };
+        let tag_end = tag_start + end_offset;
+        let tag = &source[tag_start..=tag_end];
+        output.push_str(tag);
+        let body = tag[1..tag.len() - 1].trim();
+        if let Some(name) = body.strip_prefix('/') {
+            let name = name.trim();
+            if name == "t" && text_depth > 0 {
+                text_depth -= 1;
+            }
+            if name == "sheetData" {
+                in_sheet_data = false;
+            }
+        } else if !body.starts_with(['?', '!']) && !body.ends_with('/') {
+            let name_end = body
+                .find(|ch: char| ch.is_whitespace() || ch == '/')
+                .unwrap_or(body.len());
+            match &body[..name_end] {
+                "sheetData" => in_sheet_data = true,
+                "t" if in_sheet_data => text_depth += 1,
+                _ => {}
+            }
+        }
+        cursor = tag_end + 1;
+    }
+    output.into_bytes()
+}
