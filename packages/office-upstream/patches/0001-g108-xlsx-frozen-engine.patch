+fn normalize_styles_xml(source: &[u8]) -> Vec<u8> {
+    let mut normalized = match std::str::from_utf8(source) {
+        Ok(text) => text.to_owned(),
+        Err(_) => return source.to_vec(),
+    };
+    if !normalized.contains("<cellStyles") {
+        let Some(index) = normalized.find("<cellXfs") else {
+            return normalized.into_bytes();
+        };
+        normalized.insert_str(
+            index,
+            "<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>",
+        );
+    }
+    let Some(start) = normalized.find("<cellXfs") else {
+        return normalized.into_bytes();
+    };
+    let Some(open_end) = normalized[start..].find('>') else {
+        return normalized.into_bytes();
+    };
+    let content_start = start + open_end + 1;
+    let Some(close_offset) = normalized[content_start..].find("</cellXfs>") else {
+        return normalized.into_bytes();
+    };
+    let content_end = content_start + close_offset;
+    let cell_xfs = normalize_cell_xfs(&normalized[content_start..content_end]);
+    normalized.replace_range(content_start..content_end, &cell_xfs);
+    normalized.into_bytes()
+}
+
+fn normalize_cell_xfs(source: &str) -> String {
+    let mut output = String::with_capacity(source.len());
+    let mut cursor = 0;
+    while let Some(offset) = source[cursor..].find("<xf") {
+        let start = cursor + offset;
+        output.push_str(&source[cursor..start]);
+        let next = source.as_bytes().get(start + 3).copied();
+        if !matches!(
+            next,
+            Some(b'>') | Some(b'/') | Some(b' ') | Some(b'\t') | Some(b'\n') | Some(b'\r')
+        ) {
+            output.push_str("<xf");
+            cursor = start + 3;
+            continue;
+        }
+        let Some(end_offset) = source[start..].find('>') else {
+            output.push_str(&source[start..]);
+            break;
+        };
+        let end = start + end_offset;
+        let tag = &source[start..=end];
+        if tag.contains("xfId=") {
+            output.push_str(tag);
+        } else if let Some(slash) = tag.rfind("/>") {
+            output.push_str(&tag[..slash]);
+            output.push_str(" xfId=\"0\"/>");
+        } else {
+            output.push_str(&tag[..tag.len() - 1]);
+            output.push_str(" xfId=\"0\">");
+        }
+        cursor = end + 1;
+    }
+    output.push_str(&source[cursor..]);
+    output
+}
