+/// Attributes that decide whether one CT_Xf applies a component of its base format.
+/// compareAttributes=true spells an xsd:boolean, whose both spellings are the same
+/// value, so a delta that sets applyFont="true" and one that sets applyFont="1"
+/// identify the same format.
+const XF_APPLY_ATTRIBUTES = [
+  'applyNumberFormat',
+  'applyFont',
+  'applyFill',
+  'applyBorder',
+  'applyAlignment',
+  'applyProtection',
+] as const
