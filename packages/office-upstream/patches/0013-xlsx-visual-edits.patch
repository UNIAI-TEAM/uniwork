 export const UNIWORK_XLSX_VISUAL_ADDITIONS = true
 
+/// UniWork patch 0013 capability marker: a bundle exporting it binds
+/// visualEdits AFTER formulaValues on applyCellEditsToXlsx (edits to visuals
+/// that already live in the file) and exports readEntriesBase64. Hosts refuse
+/// a bundle without it instead of silently dropping visual edits.
+export const UNIWORK_XLSX_VISUAL_EDITS = true
+
+/// UniWork patch 0013: base64 bytes of package entries the render model draws
+/// (pictures already in the file). A missing entry, a directory, or an entry
+/// whose decoded size exceeds maxBytes reads as null.
+export async function readEntriesBase64(
+  buffer: Buffer,
+  paths: readonly string[],
+  maxBytes: number,
+): Promise<Record<string, string | null>> {
+  const zip = await loadSafeZip(buffer)
+  const out: Record<string, string | null> = {}
+  for (const path of paths) {
+    const file = zip.file(path)
+    if (!file || file.dir) {
+      out[path] = null
+      continue
+    }
+    const bytes = await file.async('uint8array')
+    out[path] =
+      bytes.byteLength > maxBytes
+        ? null
+        : Buffer.from(bytes.buffer, bytes.byteOffset, bytes.byteLength).toString('base64')
+  }
+  return out
+}
