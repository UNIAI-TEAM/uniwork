+    /// Rewrite `xl/worksheets/sheet1.xml` of the package at `path`: any
+    /// `<cols>` section is replaced by `cols` (placed before `sheetData`).
+    fn with_sheet_cols(path: &Path, cols: &str) {
+        use std::io::Write as _;
+
+        let source = std::fs::read(path).unwrap();
+        let mut archive = ZipArchive::new(std::io::Cursor::new(source)).unwrap();
+        let mut writer = ZipWriter::new(std::fs::File::create(path).unwrap());
+        let options = SimpleFileOptions::default().compression_method(CompressionMethod::Deflated);
+        for index in 0..archive.len() {
+            let mut entry = archive.by_index(index).unwrap();
+            let name = entry.name().to_owned();
+            let mut bytes = Vec::new();
+            entry.read_to_end(&mut bytes).unwrap();
+            if name == "xl/worksheets/sheet1.xml" {
+                let mut xml = String::from_utf8(bytes).unwrap();
+                if let (Some(start), Some(end)) = (xml.find("<cols"), xml.find("</cols>")) {
+                    xml.replace_range(start..end + "</cols>".len(), "");
+                }
+                let at = xml.find("<sheetData").unwrap();
+                xml.insert_str(at, cols);
+                bytes = xml.into_bytes();
+            }
+            writer.start_file(name, options).unwrap();
+            writer.write_all(&bytes).unwrap();
+        }
+        writer.finish().unwrap();
+    }
+
