+/// Give every `<col>` that has no `width` one, so IronCalc's column import
+/// (which requires the attribute) accepts it. OOXML makes `width` optional and
+/// the gateway writes outline-only, hidden-only and style-only columns without
+/// it. The value is the sheet's `defaultColWidth`, else Excel's 8.43; it only
+/// reaches the throwaway recalc copy, where column widths do not affect values.
+fn fill_col_widths(source: Vec<u8>) -> Vec<u8> {
+    let Ok(text) = std::str::from_utf8(&source) else {
+        return source;
+    };
+    let Some(cols_start) = text.find("<cols") else {
+        return source;
+    };
+    let Some(cols_offset) = text[cols_start..].find("</cols>") else {
+        return source;
+    };
+    let cols_end = cols_start + cols_offset;
+    let default_width = sheet_default_col_width(text).unwrap_or("8.43");
+    let section = &text[cols_start..cols_end];
+    let mut output = String::with_capacity(text.len() + 64);
+    output.push_str(&text[..cols_start]);
+    let mut cursor = 0;
+    let mut changed = false;
+    while let Some(offset) = section[cursor..].find("<col") {
+        let start = cursor + offset;
+        output.push_str(&section[cursor..start]);
+        let next = section.as_bytes().get(start + 4).copied();
+        let Some(end_offset) = section[start..].find('>') else {
+            output.push_str(&section[start..]);
+            cursor = section.len();
+            break;
+        };
+        let end = start + end_offset;
+        let tag = &section[start..=end];
+        let is_col = matches!(
+            next,
+            Some(b'/') | Some(b' ') | Some(b'\t') | Some(b'\n') | Some(b'\r')
+        );
+        if !is_col || has_attribute(tag, "width") {
+            output.push_str(tag);
+        } else {
+            let body_end = if tag.ends_with("/>") { tag.len() - 2 } else { tag.len() - 1 };
+            output.push_str(tag[..body_end].trim_end());
+            output.push_str(&format!(" width=\"{default_width}\""));
+            output.push_str(&tag[body_end..]);
+            changed = true;
+        }
+        cursor = end + 1;
+    }
+    if !changed {
+        return source;
+    }
+    output.push_str(&section[cursor..]);
+    output.push_str(&text[cols_end..]);
+    output.into_bytes()
+}
+
+/// `defaultColWidth` from the worksheet's `<sheetFormatPr>`, when it is a number.
+fn sheet_default_col_width(text: &str) -> Option<&str> {
+    let start = text.find("<sheetFormatPr")?;
+    let end = start + text[start..].find('>')?;
+    let value = attribute_value(&text[start..=end], "defaultColWidth")?;
+    value.parse::<f64>().ok().filter(|width| width.is_finite() && *width > 0.0)?;
+    Some(value)
+}
+
+/// Whether `tag` carries the attribute `name` (whole name, so `width` never
+/// matches `customWidth`).
+fn has_attribute(tag: &str, name: &str) -> bool {
+    attribute_value(tag, name).is_some()
+}
+
+fn attribute_value<'a>(tag: &'a str, name: &str) -> Option<&'a str> {
+    let mut search = 0;
+    while let Some(offset) = tag[search..].find(name) {
+        let at = search + offset;
+        search = at + name.len();
+        let preceded = tag[..at].chars().next_back().is_some_and(char::is_whitespace);
+        let rest = tag[search..].trim_start();
+        if !preceded || !rest.starts_with('=') {
+            continue;
+        }
+        let rest = rest[1..].trim_start();
+        let quote = rest.chars().next()?;
+        if quote != '"' && quote != '\'' {
+            continue;
+        }
+        let close = rest[1..].find(quote)?;
+        return Some(&rest[1..=close]);
+    }
+    None
+}
