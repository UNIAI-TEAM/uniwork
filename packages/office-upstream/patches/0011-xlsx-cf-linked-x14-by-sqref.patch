+/// Order-insensitive area key: `B2:B6 $C$3` and `C3 B2:B6` are the same sqref.
+function sqrefKey(sqref: string): string {
+  return sqref
+    .split(/\s+/)
+    .filter((ref) => ref !== '')
+    .map((ref) => {
+      const [start, end] = ref.replaceAll('$', '').toUpperCase().split(':')
+      return end === undefined || end === start ? start : `${start}:${end}`
+    })
+    .sort()
+    .join(' ')
+}
+
+const LINKED_UNIVER_TYPES: Readonly<Record<string, string>> = {
+  dataBar: 'dataBar',
+  colorScale: 'colorScale',
+  iconSet: 'iconSet',
+}
+
+/// A linked base rule matches the snapshot rule of the same Univer family:
+/// data bar, colour scale and icon set by name, any other OOXML type
+/// (cellIs, expression, ...) a highlight rule.
+function linkedTypeMatches(ooxmlType: string, rule: Record<string, unknown>): boolean {
+  return (LINKED_UNIVER_TYPES[ooxmlType] ?? 'highlightCell') === rule.type
+}
+
+/// Drops a removed linked rule: its base block, and its x14 half in the
+/// worksheet extLst (found by x14:id), pruning the containers it leaves empty.
+function removeLinkedBlock(xml: string, block: PreservedBlock): string {
+  const id = /<(?:\w+:)?id>([^<]+)<\/(?:\w+:)?id>/.exec(block.text)?.[1]
+  const start = xml.indexOf(block.text)
+  if (id === undefined || start === -1) throw new CfEditError(linkedMessage(block.text))
+  const without = xml.slice(0, start) + xml.slice(start + block.text.length)
+  const escapedId = id.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')
+  const x14Rule = new RegExp(`<(\\w+):cfRule\\b[^>]*\\bid="${escapedId}"[^>]*>[\\s\\S]*?</\\1:cfRule>`)
+  return pruneEmptyX14Conditional(without.replace(x14Rule, ''))
+}
+
+/// Removes x14 conditional-formatting containers that hold no rule any more:
+/// an x14:conditionalFormatting with only its sqref, an empty
+/// x14:conditionalFormattings, the conditional-formatting ext that held it
+/// and the worksheet extLst when that was its only ext.
+function pruneEmptyX14Conditional(xml: string): string {
+  return xml
+    .replace(/<(\w+):conditionalFormatting\b[^>]*>(?:(?!<\w+:cfRule\b)[\s\S])*?<\/\1:conditionalFormatting>/g, '')
+    .replace(/<(\w+):conditionalFormattings\b[^>]*>\s*<\/\1:conditionalFormattings>|<\w+:conditionalFormattings\b[^>]*\/>/g, '')
+    .replace(/<ext\b[^>]*\buri="\{78C0D931-6437-407[dD]-A8EE-F0AAD7539E65\}"[^>]*>\s*<\/ext>/g, '')
+    .replace(/<extLst>\s*<\/extLst>/g, '')
+}
+
 function linkedMessage(block: string): string {
   return block.includes('type="dataBar"')
     ? 'This range has a data-bar extension format (x14) that cannot be modified yet'
