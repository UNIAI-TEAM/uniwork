{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    // ES2023 for the array methods the ported primitives use (findLastIndex).
    // Deliberately not "ESNext": that moves with the TypeScript version and
    // would let code assume runtime APIs Node 22 and current browsers do not
    // ship. `target` stays ES2022 — these are methods, not syntax, so nothing
    // needs downlevelling.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  }
}
