  102 |   await expect(dialog).toBeHidden();
  103 |   await documentAction(page, "Chia sẻ");
  104 |   await expect(dialog.getByText("Liên kết công khai", { exact: true })).toBeVisible({ timeout: 30_000 });
  105 |   await expect(dialog.getByTestId("share-created-url")).toHaveCount(0);
