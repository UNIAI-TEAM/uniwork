  75  |   await shot(page, "share-dialog-dark-vi");
  76  |   await page.evaluate(() => document.documentElement.classList.remove("dark"));
  77  | 
  78  |   // A revoke whose dry run has something to say is confirmed in the row (share-access-confirm).
  79  |   await revokeOrg.click();
  80  |   const confirmRevoke = dialog.getByTestId("share-access-confirm");
  81  |   await expect
  82  |     .poll(async () => (await confirmRevoke.isVisible()) || (await revokeOrg.count()) === 0, { timeout: 30_000 })
  83  |     .toBe(true);
  84  |   if (await confirmRevoke.isVisible()) await confirmRevoke.getByRole("button", { name: "Xác nhận" }).click();
  85  |   await expect(revokeOrg).toHaveCount(0, { timeout: 30_000 });
  86  |   // The owner row survives the revoke: the badge reads "Chủ sở hữu" and, for the owner, carries the transfer button.
  87  |   await expect(dialog.getByText("Chủ sở hữu", { exact: true })).toBeVisible();
  88  |   await expect(dialog.getByRole("button", { name: "Chuyển quyền sở hữu" })).toBeVisible();
  89  | 
  90  |   // Anonymous second session: no app session, only the token.
  91  |   const anon = await browser.newContext();
  92  |   const visitor = await anon.newPage();
  93  |   await visitor.goto(linkPath);
  94  |   await expect(visitor.getByText("Nội dung công khai của trang")).toBeVisible({ timeout: 60_000 });
  95  |   await expect(visitor.getByText("Chia sẻ qua liên kết công khai")).toBeVisible();
  96  |   await shot(visitor, "public-page-light-vi");
  97  |   await visitor.setViewportSize({ width: 390, height: 844 });
  98  |   await shot(visitor, "public-page-mobile-vi");
  99  | 
  100 |   // Reopening the dialog never shows the raw URL again.
