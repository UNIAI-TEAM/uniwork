{
  "name": "uniwork",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "packageExtensions": {
      "@tiptap/extension-placeholder@3.30.6": {
        "dependencies": {
          "@tiptap/extensions": "3.30.6"
        }
      }
    },
    "overrides": {
      "js-yaml": "4.3.2",
      "@tiptap/core": "3.30.6",
      "@tiptap/extension-blockquote": "3.30.6",
      "@tiptap/extension-bold": "3.30.6",
      "@tiptap/extension-bubble-menu": "3.30.6",
      "@tiptap/extension-bullet-list": "3.30.6",
      "@tiptap/extension-code": "3.30.6",
      "@tiptap/extension-code-block": "3.30.6",
      "@tiptap/extension-code-block-lowlight": "3.30.6",
      "@tiptap/extension-document": "3.30.6",
      "@tiptap/extension-dropcursor": "3.30.6",
      "@tiptap/extension-floating-menu": "3.30.6",
      "@tiptap/extension-gapcursor": "3.30.6",
      "@tiptap/extension-hard-break": "3.30.6",
      "@tiptap/extension-heading": "3.30.6",
      "@tiptap/extension-highlight": "3.30.6",
      "@tiptap/extension-horizontal-rule": "3.30.6",
      "@tiptap/extension-image": "3.30.6",
      "@tiptap/extension-italic": "3.30.6",
      "@tiptap/extension-link": "3.30.6",
      "@tiptap/extension-list": "3.30.6",
      "@tiptap/extension-list-item": "3.30.6",
      "@tiptap/extension-list-keymap": "3.30.6",
      "@tiptap/extension-mention": "3.30.6",
      "@tiptap/extension-ordered-list": "3.30.6",
      "@tiptap/extension-paragraph": "3.30.6",
      "@tiptap/extension-placeholder": "3.30.6",
      "@tiptap/extension-strike": "3.30.6",
      "@tiptap/extension-table": "3.30.6",
      "@tiptap/extension-table-cell": "3.30.6",
      "@tiptap/extension-table-header": "3.30.6",
      "@tiptap/extension-table-row": "3.30.6",
      "@tiptap/extension-text": "3.30.6",
      "@tiptap/extension-typography": "3.30.6",
      "@tiptap/extension-underline": "3.30.6",
      "@tiptap/extensions": "3.30.6",
      "@tiptap/markdown": "3.30.6",
      "@tiptap/pm": "3.30.6",
      "@tiptap/react": "3.30.6",
      "@tiptap/starter-kit": "3.30.6",
      "@tiptap/suggestion": "3.30.6"
    }
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "lint": "bash scripts/lint-gate.sh",
    "test": "turbo test --filter=!@uniwork/e2e",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs",
    "brand:build": "bash scripts/brand/build.sh",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "knip": "knip"
  },
  "devDependencies": {
    "knip": "^6.33.0",
    "turbo": "^2.5.0"
  }
}
