{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "catalog"
  ],
  "workspaces": {
    ".": {
      "ignore": ["scripts/landing-film/**"],
      "entry": [
        "scripts/**/*.mjs",
        "scripts/load/*.k6.js",
        "scripts/office-g0/*.ts"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "playwright-core",
        "k6",
        "sharp",
        "jszip"
      ]
    },
    "apps/web": {
      "ignore": [
        "public/sw.js"
      ]
    },
    "packages/*": {},
    "packages/views": {
      "ignoreExportsUsedInFile": true
    },
    "e2e": {
      "entry": [
        "*.spec.ts",
        "office-g0/**/*.{mjs,mts}",
        "playwright.office-g0*.config.ts"
      ],
      "ignoreBinaries": [
        "go"
      ],
      "ignoreDependencies": [
        "pdfjs-dist",
        "@napi-rs/canvas"
      ]
    },
    "packages/tsconfig": {
      "ignoreUnresolved": [
        "next"
      ]
    }
  }
}
