{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "catalog"
  ],
  "workspaces": {
    ".": {
      "ignore": [
        "scripts/landing-film/**"
      ],
      "entry": [
        "scripts/**/*.mjs",
        "scripts/load/*.k6.js",
        "scripts/office-g0/*.ts",
        "docs/office/g3g4/samples/web-launch-ticket.mjs"
      ],
      "ignoreBinaries": [
        "rustc"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "playwright-core",
        "lucide-react",
        "k6",
        "sharp",
        "jszip",
        "esbuild",
        "@univerjs/core",
        "@univerjs/sheets",
        "@univerjs/preset-sheets-core"
      ]
    },
    "apps/web": {
      "ignore": [
        "public/sw.js",
        "platform/office/**"
      ]
    },
    "apps/office-desktop": {
      "ignoreExportsUsedInFile": true,
      "entry": [
        "electron-main.ts",
        "main/index.ts",
        "preload/index.ts",
        "renderer/index.tsx",
        "renderer/styles.css",
        "scripts/*.mjs"
      ],
      "ignoreDependencies": [
        "@electron/asar",
        "app-builder-lib",
        "builder-util"
      ]
    },
    "packages/*": {},
    "packages/office-engine": {
      "entry": [
        "test/replay/g2-03-replay.mjs",
        "test/replay/adapter-entry.ts",
        "test/replay/g2-04-replay.mjs",
        "test/replay/g2-06-replay.mjs"
      ],
      "ignoreDependencies": [
        "harfbuzzjs"
      ]
    },
    "packages/office-upstream": {
      "ignoreUnresolved": [
        "../upstream/apps/docs/src/renderer/editor/note-dom"
      ],
      "ignore": [
        "upstream/**"
      ],
      "entry": [
        "shims/docs-renderer-entry.ts",
        "shims/genoffice-ui.ts",
        "shims/xlsx-renderer-entry.ts",
        "shims/xlsx-renderer/*.ts",
        "shims/pptx-renderer-entry.ts",
        "shims/pptx-renderer/*.ts"
      ],
      "ignoreDependencies": [
        "@univerjs/*",
        "@genoffice/ui",
        "numfmt"
      ]
    },
    "packages/views": {
      "ignoreExportsUsedInFile": true
    },
    "e2e": {
      "entry": [
        "*.spec.ts",
        "office-g0/**/*.{mjs,mts}",
        "playwright.office-g0*.config.ts"
      ],
      "ignoreBinaries": [
        "go"
      ],
      "ignoreDependencies": [
        "pdfjs-dist",
        "@napi-rs/canvas"
      ]
    },
    "packages/tsconfig": {
      "ignoreUnresolved": [
        "next"
      ]
    }
  }
}
