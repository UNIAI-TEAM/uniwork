{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "catalog"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "scripts/load/*.k6.js"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "playwright-core",
        "k6"
      ]
    },
    "apps/web": {},
    "packages/*": {},
    "e2e": {
      "entry": [
        "*.spec.ts"
      ]
    },
    "packages/tsconfig": {
      "ignoreUnresolved": [
        "next"
      ]
    }
  }
}
