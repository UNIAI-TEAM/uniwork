{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "exclude": [
    "catalog"
  ],
  "workspaces": {
    ".": {
      "ignore": [
        "scripts/landing-film/**",
        "docs/office/pdf-export/**"
      ],
      "entry": [
        "scripts/**/*.mjs",
        "scripts/load/*.k6.js",
        "scripts/office-g0/*.ts",
        "docs/office/g3g4/samples/web-launch-ticket.mjs"
      ],
      "ignoreBinaries": [
        "rustc",
        "awk",
        "go"
      ],
      "ignoreDependencies": [
        "@playwright/test",
        "playwright-core",
        "lucide-react",
        "k6",
        "sharp",
        "jszip",
        "esbuild",
        "electron"
      ]
    },
    "apps/web": {
      "ignore": [
        "public/sw.js"
      ]
    },
    "apps/chat-desktop": {},
    "apps/chat-mobile": {
      "ignore": [
        "global.css",
        "lib/theme.ts",
        "lib/use-color-scheme.ts"
      ],
      "ignoreDependencies": [
        "@expo/vector-icons",
        "@rn-primitives/avatar",
        "@rn-primitives/portal",
        "@rn-primitives/radio-group",
        "@rn-primitives/separator",
        "@rn-primitives/slot",
        "@rn-primitives/switch",
        "class-variance-authority",
        "expo-status-bar",
        "i18next",
        "react-i18next"
      ]
    },
    "packages/*": {},
    "packages/office-engine": {
      "entry": [
        "test/replay/adapter-entry.ts",
        "test/replay/g2-04-replay.mjs"
      ],
      "ignoreDependencies": [
        "harfbuzzjs"
      ]
    },
    "packages/office-upstream": {
      "ignore": [
        "upstream/**"
      ]
    },
    "packages/views": {
      "ignoreExportsUsedInFile": true
    },
    "e2e": {
      "entry": [
        "*.spec.ts",
        "office-g0/**/*.{mjs,mts}",
        "playwright.office-g0*.config.ts"
      ],
      "ignoreBinaries": [
        "go"
      ],
      "ignoreDependencies": [
        "pdfjs-dist",
        "@napi-rs/canvas"
      ]
    },
    "packages/tsconfig": {
      "ignoreUnresolved": [
        "next"
      ]
    }
  }
}
