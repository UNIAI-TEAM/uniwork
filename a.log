$ listeners() { awk -v h="$(printf ':%04X' "$1")" '$4=="0A" && substr($2, length($2)-4)==h {print $10}' /proc/net/tcp /proc/net/tcp6; }; for p in 3000 8080; do for ino in $(listeners $p); do for fd in /proc/[0-9]*/fd/*; do if [ "$(readlink "$fd" 2>/dev/null)" = "socket:[$ino]" ]; then pid=${fd#/proc/}; pid=${pid%%/*}; echo "port $p: kill $pid $(tr '\0' ' ' < /proc/$pid/cmdline | cut -c1-80)"; kill "$pid"; fi; done; done; done; sleep 2; for p in 3000 8080; do if [ -n "$(listeners $p)" ]; then echo "port $p still taken"; exit 1; fi; done; echo "ports 3000 8080 free"
ports 3000 8080 free
