$ bash scripts/office/g5g6g7/harness/stop.sh || true; for d in .harness-run .harness-run-r*; do [ -d "$d" ] && HARNESS_RUN_DIR="$PWD/$d" bash scripts/office/g5g6g7/harness/stop.sh; done; me=$(ps -o pgid= -p $$ | tr -d " "); for p in $(pgrep -f "[.]harness-run" || true); do g=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d " "); [ -n "$g" ] && [ "$g" != "$me" ] && { echo "stopping leftover group $g of pid $p: $(ps -o args= -p "$p" 2>/dev/null | cut -c1-120)"; kill -TERM -- "-$g" 2>/dev/null; }; done; sleep 3; left=$(pgrep -f "[.]harness-run" | while read p; do g=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d " "); [ "$g" != "$me" ] && echo "$p"; done); [ -z "$left" ] && echo "no leftover harness process" || echo "LEFTOVER $left"; rm -rf .harness-run-r13e; for p in $(pgrep -f "next dev" || true); do c=$(readlink -f /proc/$p/cwd 2>/dev/null); case "$c" in "$PWD"/apps/web*) echo "stopping stale next dev pid $p cwd $c"; kill "$p";; esac; done; true
