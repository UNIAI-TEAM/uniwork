$ bash scripts/office/g5g6g7/harness/stop.sh || true; HARNESS_RUN_DIR="$PWD/.harness-run-r12c" bash scripts/office/g5g6g7/harness/stop.sh || true; for r in r8a r8b r8c r9 r10 r11 r12a r12b; do [ -d ".harness-run-$r" ] && HARNESS_RUN_DIR="$PWD/.harness-run-$r" bash scripts/office/g5g6g7/harness/stop.sh; done; me=$(ps -o pgid= -p $$ | tr -d " "); for p in $(pgrep -f "[.]harness-run(/|-r(8|9|10|11|12a|12b)/)" || true); do g=$(ps -o pgid= -p "$p" 2>/dev/null | tr -d " "); echo "stopping leftover group $g of pid $p: $(ps -o args= -p "$p" 2>/dev/null | cut -c1-120)"; [ -n "$g" ] && [ "$g" != "$me" ] && kill -TERM -- "-$g" 2>/dev/null; done; for p in $(pgrep -f "[h]arness-run-r(8|9|10|11|12a|12b)" || true); do echo "stopping leftover pid $p: $(ps -o args= -p "$p" 2>/dev/null | cut -c1-120)"; kill "$p" 2>/dev/null; done; sleep 3; pgrep -af "[.]harness-run" || echo "no leftover harness process"; rm -rf .harness-run-r12c; for p in $(pgrep -f "next dev" || true); do c=$(readlink -f /proc/$p/cwd 2>/dev/null); case "$c" in "$PWD"/apps/web*) echo "stopping stale next dev pid $p cwd $c"; kill "$p";; esac; done; sleep 2; pgrep -af "next dev" || echo "no next dev left"; true
