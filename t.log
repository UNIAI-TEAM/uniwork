.set-backup-lead {
  margin: 0;
  font-size: 13px;
  color: var(--text-secondary);
  line-height: 1.45;
}

.set-backup-status {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 10px;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-content);
}

.set-backup-status span {
  display: block;
  font-size: 11px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.set-backup-status strong {
  font-size: 13px;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.set-backup-sim {
  grid-column: 1 / -1;
  margin: 0;
  font-size: 12px;
  color: var(--accent);
}

.set-backup-login {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-content);
}

.set-backup-login p {
  margin: 0;
  flex: 1;
  min-width: 200px;
  font-size: 13px;
  color: var(--text);
}

.set-backup-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.set-backup-skus {
  display: flex;
  flex-direction: column;
}

.set-backup-sku .set-field-label {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.set-backup-price {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.set-backup-badge {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  color: var(--accent);
  background: color-mix(in srgb, var(--accent) 16%, transparent);
}

.set-backup-msg {
  margin: 0;
  font-size: 12px;
  color: var(--text-secondary);
}

.set-backup-err {
  margin: 0;
  font-size: 12px;
  color: var(--danger);
}

/* ── UniAI PWA install ──────────────────────────────────── */
.set-uniai {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.set-uniai-hero {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-content);
}

.set-uniai-qr-block {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1;
}

.set-uniai-qr {
  width: 160px;
  height: 160px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface);
  flex-shrink: 0;
}

.set-uniai-qr-placeholder {
  background: var(--bg-content);
}

.set-uniai-hero strong {
  display: block;
  font-size: 15px;
  color: var(--text);
}

.set-uniai-url {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: var(--text-secondary);
  word-break: break-all;
}

.set-uniai-qr-hint {
  margin: 8px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
  line-height: 1.4;
  max-width: 28rem;
}

.set-uniai-steps,
.set-uniai-bullets {
  margin: 0;
  padding: 0 0 0 18px;
  font-size: 13px;
  color: var(--text);
  line-height: 1.5;
}

.set-uniai-steps li + li,
.set-uniai-bullets li + li {
  margin-top: 8px;
}

/* Settings → About: product identity above the version rows */
.set-about-hero {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 4px 0 18px;
}

.set-about-logo {
  width: 64px;
  height: 64px;
  flex-shrink: 0;
  border-radius: 14px;
}

.set-about-name {
  font-size: 20px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.25;
}

.set-about-tagline {
  margin-top: 2px;
  font-size: 13px;
  line-height: 1.45;
  color: var(--text-secondary);
}

.set-about-copyright {
  margin: 18px 0 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--text-secondary);
}

/* Settings → About: upstream attribution and the shipped legal files */
.set-about-attribution {
  margin: 4px 0 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--text-secondary);
}

.set-about-legal-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.set-about-legal-error {
  margin: 8px 0 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--danger);
}

/* ── Settings → Account: UniWork account ── */

.acct-pane {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 12px 0 8px;
}

.acct-heading {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.acct-card {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  background: var(--surface-subtle);
}

.acct-card-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--account-avatar-bg);
  color: var(--surface);
  font-size: 15px;
  font-weight: 600;
}

.acct-card-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
  /* wraps under the avatar before the email has to break inside a word */
  flex: 1 1 10rem;
}

.acct-card-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}

.acct-card-email {
  font-size: 12px;
  color: var(--text-secondary);
  /* only a single token wider than the whole card breaks inside a word */
  overflow-wrap: break-word;
}

.acct-card-sync {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: var(--text-secondary);
}

.acct-notice {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-content);
  color: var(--text-primary);
}

.acct-notice.warn {
  border-color: var(--danger-border);
  background: var(--danger-bg);
}

.acct-notice-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.acct-notice-title {
  font-size: 13px;
  font-weight: 600;
}

.acct-notice-body {
  font-size: 12px;
  line-height: 1.45;
  color: var(--text-secondary);
}

.acct-notice-error,
.acct-inline-error {
  font-size: 12px;
  line-height: 1.45;
  color: var(--danger-text);
}

.acct-dot-spinner {
  flex-shrink: 0;
  width: 12px;
  height: 12px;
  margin-top: 2px;
  border: 2px solid var(--border);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: acct-spin 0.9s linear infinite;
}

@keyframes acct-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (prefers-reduced-motion: reduce) {
  .acct-dot-spinner {
    animation: none;
  }
}

/* server address form: label over a full-width field, actions under it */
.acct-server-form {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.acct-server-form .set-input {
  width: 100%;
  box-sizing: border-box;
}

.acct-actions {
  flex-wrap: wrap;
  padding-top: 12px;
}

.acct-actions .set-btn:focus-visible,
.acct-org-dd .gs-dd-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

/* working-organization popup: grows leftwards from the trigger's right edge
 * (the value sits at the row end), wide enough for a reason line, and never
 * wider than the window */
.acct-org-dd .gs-dd-pop {
  left: auto;
  right: anchor(right);
  min-width: max(220px, anchor-size(width));
  max-width: calc(var(--ui-vw) * 100 - 48px);
}

.acct-org-dd .gs-dd-item {
  white-space: normal;
  overflow-wrap: normal;
  word-break: normal;
}

.acct-org-opt {
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.acct-org-opt-name {
  font-size: 13px;
  color: var(--text-muted);
}

.acct-org-opt-reason {
  font-size: 12px;
  line-height: 1.35;
  color: var(--danger-text);
}

/* organization step after sign-in (account in several organizations) */
.uw-org-step {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--border-subtle);
  border-radius: 12px;
  background: var(--bg-content);
}

.uw-org-head {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.uw-org-title {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-primary);
}

.uw-org-body,
.uw-org-gone {
  margin: 0;
  font-size: 12px;
  line-height: 1.45;
  color: var(--text-secondary);
}

.uw-org-gone {
  padding: 6px 10px;
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--text-primary);
}

.uw-org-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.uw-org-row {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 44px;
  padding: 6px 10px;
  border: 1px solid var(--border-subtle);
  border-radius: 8px;
  background: var(--surface);
  cursor: pointer;
}

.uw-org-row:hover {
  background: var(--hover);
}

.uw-org-row.checked {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.uw-org-row:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

.uw-org-row.locked {
  cursor: default;
  background: var(--surface);
}

.uw-org-row.locked .uw-org-name {
  color: var(--text-muted);
}

.uw-org-radio {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  border: 1.5px solid var(--border);
  border-radius: 50%;
  background: var(--surface);
}

.uw-org-row.checked .uw-org-radio {
  border: 5px solid var(--accent);
}

.uw-org-row.locked .uw-org-radio {
  border-style: dashed;
}

.uw-org-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.uw-org-name {
  font-size: 13px;
  font-weight: 500;
  color: var(--text-primary);
  overflow-wrap: anywhere;
}

.uw-org-role,
.uw-org-reason {
  font-size: 12px;
  color: var(--text-secondary);
}

.uw-org-reason {
  color: var(--danger-text);
}

.uw-org-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}

.uw-org-actions .set-btn {
  gap: 6px;
}

.uw-org-actions .set-btn[aria-disabled='true'] {
  opacity: 0.55;
  cursor: default;
}

.uw-org-actions .set-btn:focus-visible,
.uw-org-blocked .set-btn:focus-visible,
.uw-org-error .set-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

.uw-org-blocked,
.uw-org-error {
  flex-wrap: wrap;
  align-items: center;
}

.uw-org-blocked .acct-notice-text,
.uw-org-error .acct-notice-text {
  flex: 1 1 12rem;
}

.uw-org-error .acct-notice-title {
  font-weight: 400;
}

.uw-org-error .set-btn {
  flex-shrink: 0;
}

@media (pointer: coarse) {
  .uw-org-actions .set-btn,
  .uw-org-blocked .set-btn,
  .uw-org-error .set-btn {
    height: 44px;
  }
}

/* UniWork cloud AI (Settings → Account rows, AI media notice) */
.cloud-notice {
  margin-bottom: 12px;
}

.cloud-notice .acct-notice-text {
  flex: 1;
}

.cloud-notice-action {
  flex-shrink: 0;
  align-self: center;
}

.cloud-state.credits-exhausted,
.cloud-state.subscription-inactive,
.cloud-state.unavailable {
  color: var(--danger-text);
}

.cloud-state.not-entitled,
.cloud-renews {
  color: var(--text-secondary);
}

.cloud-renews {
  margin-left: 8px;
  font-size: 12px;
}

/* unsaved-changes prompt pinned to the bottom of the dialog */
.set-leave {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 12px 22px;
  border-top: 1px solid var(--border-subtle);
  background: var(--bg-content);
}

/* a pane that could not load: the reason and a retry, inline */
.set-inline-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  border: 1px solid var(--danger-border);
  background: var(--danger-bg);
  font-size: 13px;
  color: var(--danger-text);
}

/* loading placeholder rows for panes that read their settings first */
.set-skel {
  display: block;
  width: 34%;
  height: 12px;
  border-radius: 6px;
  background: var(--bg-hover);
  animation: set-skel-pulse 1.4s ease-in-out infinite;
}

.set-skel-control {
  width: 28%;
  height: 26px;
  margin-inline-start: auto;
}

@keyframes set-skel-pulse {
  50% {
    opacity: 0.5;
  }
}

@media (prefers-reduced-motion: reduce) {
  .set-skel {
    animation: none;
  }
}
