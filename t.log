+       runtime,
+       lazyWorkbookRef,
+       visualDisposablesRef,
+       visualInstallTimerRef,
+       chartEditRef,
+       chartVectorRef,
+       shapeEditRef,
+     )
+   }
+
+   function refreshDemoVisuals(): void {
+     if (lazyWorkbookRef.current) return
