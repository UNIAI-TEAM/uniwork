+     saveTo: async (path, overwrite) => handleSave('save-as', true, { path, overwrite }),
+   }
+   useEffect(() => {
+     const handlers = mcpSheetHandlersRef
+     return installSheetsMcpBridge({
+       hasWorkbook: () => handlers.current?.hasWorkbook() ?? false,
