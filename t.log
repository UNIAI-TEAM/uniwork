/* on/off switch (analytics toggle) */
.set-switch {
  position: relative;
  flex-shrink: 0;
  width: 42px;
  height: 24px;
  padding: 0;
  border: none;
  border-radius: 12px;
  background: var(--bg-hover-strong);
  box-shadow: inset 0 0 0 1px var(--border-control);
  cursor: pointer;
  transition: background 0.15s ease;
}

.set-switch::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 2px;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-modal-strong);
  transition: transform 0.15s cubic-bezier(0.25, 1, 0.5, 1);
}

[dir='rtl'] .set-switch::after {
  left: auto;
  right: 2px;
}

.set-switch[aria-checked='true'] {
  background: var(--color-btn-primary);
  box-shadow: none;
}

.set-switch[aria-checked='true']::after {
  transform: translateX(18px);
}

[dir='rtl'] .set-switch[aria-checked='true']::after {
  transform: translateX(-18px);
}

.set-switch:disabled {
  opacity: 0.55;
  cursor: default;
}

