+         () => t('appWorkbookNotReady'),
+       ),
+     [],
+   )
+   const isCellEditing = useCallback((): boolean => {
+     const workbook = univerRef.current?.univerAPI.getActiveWorkbook() as
+       { isCellEditing?(): boolean } | null | undefined
+     return workbook?.isCellEditing?.() === true
