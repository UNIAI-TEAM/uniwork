      {showPivotDialog &&
        (() => {
          const sourceRange = onGetSourceRange()
          return (
            <PivotDialog
              hasFields={onGetPivotFields(sourceRange).length > 0}
              sourceRange={sourceRange}
              onCreate={(request) => {
                const failure = onCreatePivot(request)
                if (failure === null) openPivotPane()
