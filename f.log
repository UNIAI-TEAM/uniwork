    allow: SheetProtectionAllow
  }) => Promise<string | null>
  readonly onUnprotectSheet: (password: string) => Promise<string | null>
  readonly sheetTabActions: SheetTabActions | null
  /// Effective workbook structure lock (null = no file open).
