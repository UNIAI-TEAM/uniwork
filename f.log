    ```sql
    -- name: ClaimDomainOrder :one
    -- tenant: system
    UPDATE domain_orders
    SET claimed_at = now(), updated_at = now()
    WHERE id = (
      SELECT id FROM domain_orders
      WHERE status = $1
        AND (claimed_at IS NULL OR claimed_at < now() - interval '10 minutes')
      ORDER BY created_at
      FOR UPDATE SKIP LOCKED
      LIMIT 1
    )
    RETURNING *;
    ```
    
