+         .resolveChat({ filePath: null, tempChatId })
+         .then(async (ids) => {
+           for (const m of msgs) {
+             const appendArgs: Parameters<typeof api.appendChat>[0] = {
+               projectId: ids.projectId,
+               chatId: ids.chatId,
+               role: m.role,
+               text: m.text,
