# Overrides appended to .env.example to form a cloud agent's .env (see
# install.sh). Values mirror the CI jobs in .github/workflows/ci.yml; nothing
# here is a secret.
#
# The database host is the alias "uniwork-db" (start.sh maps it to 127.0.0.1)
# so scripts/ensure-postgres.sh treats it as a remote database and only waits
# for it, instead of trying to start the docker compose service this VM does
# not have.
DATABASE_URL=postgres://uniwork:uniwork@uniwork-db:5432/uniwork?sslmode=disable
TEST_DATABASE_URL=postgres://uniwork:uniwork@uniwork-db:5432/uniwork_test?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDIS_TEST_URL=redis://localhost:6379/1
JWT_SECRET=ci
APP_ENV=development
DEV_VERIFICATION_CODE=123456
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=uniwork-test
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_REGION=us-east-1
LOCAL_UPLOAD_DIR=/tmp/uniwork-uploads
