{
  "uid": "uniwork-web-vitals",
  "title": "UniWork · Web Vitals",
  "tags": [
    "uniwork",
    "rum"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 0,
      "type": "timeseries",
      "title": "p75 LCP theo route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le, route_pattern) (rate(uniwork_web_vitals_seconds_bucket{metric=\"lcp\"}[30m])))",
          "legendFormat": "{{route_pattern}}"
        }
      ]
    },
