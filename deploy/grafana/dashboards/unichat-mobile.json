      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le, client_version) (rate(uniwork_mobile_event_duration_seconds_bucket{event=\"message_send\"}[1h])))",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "p75 nối cuộc gọi theo version",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le, client_version) (rate(uniwork_mobile_event_duration_seconds_bucket{event=\"call_connect\"}[6h])))",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tỷ lệ 5xx theo bản build (version · OTA)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_version, client_update) (rate(uniwork_http_client_requests_total{platform=\"mobile\",status_class=\"5xx\"}[15m])) / sum by (client_version, client_update) (rate(uniwork_http_client_requests_total{platform=\"mobile\"}[15m]))",
          "legendFormat": "{{client_version}} · {{client_update}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Request theo bản build (mỗi giây)",
      "datasource": {
        "type": "prometheus",
