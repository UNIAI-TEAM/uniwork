      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_version, client_update) (rate(uniwork_http_client_requests_total{platform=\"mobile\"}[15m]))",
          "legendFormat": "{{client_version}} · {{client_update}}"
        }
