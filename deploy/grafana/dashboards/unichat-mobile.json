{
  "uid": "uniwork-unichat-mobile",
  "title": "UniWork · UniChat mobile",
  "tags": [
    "uniwork",
    "mobile"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 0,
      "type": "timeseries",
      "title": "Lần mở app theo version (mỗi phút)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_version) (rate(uniwork_mobile_events_total{event=\"app_open\"}[30m])) * 60",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Lần mở app theo bản OTA (mỗi phút)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_update) (rate(uniwork_mobile_events_total{event=\"app_open\"}[30m])) * 60",
          "legendFormat": "{{client_update}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tỷ lệ gửi tin thành công theo version",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_version) (rate(uniwork_mobile_events_total{event=\"message_send\",result=\"sent\"}[1h])) / sum by (client_version) (rate(uniwork_mobile_events_total{event=\"message_send\"}[1h]))",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tỷ lệ gửi tin thành công theo bản OTA",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_update) (rate(uniwork_mobile_events_total{event=\"message_send\",result=\"sent\"}[1h])) / sum by (client_update) (rate(uniwork_mobile_events_total{event=\"message_send\"}[1h]))",
          "legendFormat": "{{client_update}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tỷ lệ nối cuộc gọi được theo version",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_version) (rate(uniwork_mobile_events_total{event=\"call_connect\",result=\"connected\"}[6h])) / sum by (client_version) (rate(uniwork_mobile_events_total{event=\"call_connect\"}[6h]))",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tỷ lệ nối cuộc gọi được theo bản OTA",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client_update) (rate(uniwork_mobile_events_total{event=\"call_connect\",result=\"connected\"}[6h])) / sum by (client_update) (rate(uniwork_mobile_events_total{event=\"call_connect\"}[6h]))",
          "legendFormat": "{{client_update}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Mở từ push theo loại (mỗi giờ)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result) (rate(uniwork_mobile_events_total{event=\"push_open\"}[1h])) * 3600",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p75 màn hình đầu tiên theo version",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.75, sum by (le, client_version) (rate(uniwork_mobile_event_duration_seconds_bucket{event=\"first_screen\"}[1h])))",
          "legendFormat": "{{client_version}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p75 gửi tin theo version",
      "datasource": {
        "type": "prometheus",
