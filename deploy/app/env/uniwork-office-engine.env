# UniWork office-engine — non-secret production runtime (K8s ConfigMap via Helm --set-file).
# Secrets stay in Secret uniwork-office-engine (OFFICE_ENGINE_SERVICE_TOKEN, OFFICE_ENGINE_GRANT_KEY).
# Pattern matches deploy/app/env/uniwork-be.env. Every variable the engine reads
# (apps/office-engine/src/config.ts) is listed here; values below are the code defaults
# unless a comment says otherwise. Bounds are enforced at start: a bad value stops the pod.

# ==================== Listener ====================
# Bind address and port. The port must match officeEngine.port in deploy/app/uniwork/values.yaml.
OFFICE_ENGINE_HOST=0.0.0.0
OFFICE_ENGINE_PORT=8090

# ==================== File store ====================
# Bare origin(s) of the object store for presigned input/output URLs (comma-separated, no path).
# Must match the store the BE uses (see AWS_ENDPOINT_URL in uniwork-be.env). Empty = every
# output write is refused. The store's IPs also go in networkPolicy.officeEngineFileStore.
OFFICE_ENGINE_OUTPUT_ORIGINS=https://s3.hn-2.cloud.cmctelecom.vn

# ==================== Pool / queue ====================
# Concurrent jobs (1..64) and waiting jobs (1..4096). Memory: each worker may use
# OFFICE_ENGINE_MEMORY_MB plus OFFICE_ENGINE_TEMP_MB of /tmp; keep
# workers x (memory + temp) under officeEngine.resources.limits.memory and
# workers x temp under officeEngine.tmpSizeLimit (values.yaml).
OFFICE_ENGINE_MAX_WORKERS=2
OFFICE_ENGINE_MAX_QUEUE=16

# ==================== Per-job limits ====================
# Wall time per job (ms, <= 600000) and CPU time per job (ms).
OFFICE_ENGINE_MAX_JOB_MS=120000
OFFICE_ENGINE_CPU_MS=60000
# Memory and temp disk per job (MiB). Temp must hold one job's input and
# output on disk plus headroom: input_bytes + output_bytes + 64 MiB; the
# service refuses to start below that. 200 MiB in + 200 MiB out -> >= 464;
# 512 keeps the old budget above the floor.
OFFICE_ENGINE_MEMORY_MB=512
OFFICE_ENGINE_TEMP_MB=512
# The document cap: DOCUMENT_MAX_BYTES (same value as uniwork-be.env; the
# engine falls back to it) and the engine-specific overrides below.
# 209715200 = 200 MiB. The shared contract bounds both at 2 GiB.
DOCUMENT_MAX_BYTES=209715200
OFFICE_ENGINE_MAX_INPUT_BYTES=209715200
OFFICE_ENGINE_MAX_OUTPUT_BYTES=209715200

# ==================== Supervisor ====================
# Resource sampling interval (ms), how long a finished job's result is kept (ms),
# how many finished jobs are kept, and the drain time on SIGTERM (ms). Keep the
# grace under officeEngine.terminationGracePeriodSeconds.
OFFICE_ENGINE_SAMPLE_MS=100
OFFICE_ENGINE_RETENTION_MS=900000
OFFICE_ENGINE_MAX_RETAINED_JOBS=1024
OFFICE_ENGINE_SHUTDOWN_GRACE_MS=10000

# ==================== Sandbox ====================
# The image runs every job under its own uid (sandbox "required"). The worker uid/gid pool
# starts here and needs OFFICE_ENGINE_MAX_WORKERS free ids inside 1000..65533.
OFFICE_ENGINE_SANDBOX=required
OFFICE_ENGINE_WORKER_UID_BASE=60100
OFFICE_ENGINE_WORKER_GID_BASE=60100

# ==================== Test switch ====================
# Fault-injection operations for tests. Must stay 0 in every real environment.
OFFICE_ENGINE_FAULT_OPERATIONS=0

# ==================== Set by the image (do not override) ====================
# These follow the image layout (apps/office-engine/Dockerfile) and the /tmp emptyDir in
# deployment-office-engine.yaml; overriding them here would point the engine at paths that
# do not exist. Listed for reference only.
# NODE_ENV=production
# OFFICE_ENGINE_TEMP_DIR=/tmp/uniwork-office-engine
# UNIWORK_PDF_ASSETS=/app/pdf-assets
# UNIWORK_XLSX_ASSETS=/app/xlsx-assets
