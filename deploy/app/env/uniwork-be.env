# UniWork BE — non-secret production runtime (K8s ConfigMap via Helm --set-file).
# Secrets stay in Kubernetes Secrets (DATABASE_URL, REDIS_URL, JWT_SECRET,
# LIVEKIT_API_*, SMTP_PASSWORD, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, …).
# Pattern matches REAP deploy/app/env/*.env.

# ==================== Server ====================
PORT=8080
APP_ENV=production
LOG_LEVEL=info
ENABLE_SWAGGER=false
# Comma-separated CIDRs that may set X-Forwarded-For (Calico pod CIDR on REAP).
TRUSTED_PROXIES=10.244.0.0/16

# ==================== Public origins ====================
# Browser origin for the web app (CORS + Secure cookies when https).
FRONTEND_ORIGIN=https://uniwork.unicomhub.com
# Extra WebSocket Origins beyond FRONTEND_ORIGIN (comma-separated). Empty = only FRONTEND_ORIGIN.
ALLOWED_ORIGINS=
# Origin browsers use to reach this API (Google OAuth redirect is built from this).
API_PUBLIC_URL=https://uniwork.unicomhub.com
# Separate origin used by Markdown/HTML preview iframes. The matching
# PREVIEW_CAPABILITY_SECRET is injected from the uniwork-preview Secret.
PREVIEW_ORIGIN=https://preview.unicomhub.com
PREVIEW_ASSET_TTL=10m
PREVIEW_ASSET_MAX_BYTES=10485760

# ==================== Mail (SMTP) ====================
# Password: Secret uniwork-mail key SMTP_PASSWORD (never commit here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=contact@unicomhub.com
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=UniWork
MAIL_FROM=UniWork <noreply@unicomhub.com>

# ==================== Storage (CMC S3-compatible) ====================
# Flip to s3 after Secret uniwork-s3 exists (see runbook).
STORAGE_BACKEND=s3
LOCAL_UPLOAD_DIR=/tmp/uploads
# CMC Object Storage (S3 API). Keys → Secret uniwork-s3.
S3_BUCKET=uniwork
S3_REGION=hn-2
AWS_ENDPOINT_URL=https://s3.hn-2.cloud.cmctelecom.vn
# Path-style is required for most S3-compatible endpoints (CMC/MinIO).
S3_USE_PATH_STYLE=true
# Root folder inside the bucket: production/ (this cluster) or develop/ (local dev .env).
S3_KEY_PREFIX=production/
# Optional public CDN / custom domain for returned object URLs.
CLOUDFRONT_DOMAIN=

# ==================== LiveKit (non-secret) ====================
# API key/secret → Secret uniwork-livekit.
LIVEKIT_URL=wss://livekit.vn247.info:7880
MEETING_PROVIDER=livekit
LIVEKIT_TOKEN_TTL=30m
LIVEKIT_ROOM_EMPTY_TIMEOUT=
LIVEKIT_ROOM_DEPARTURE_TIMEOUT=20s
MEETING_WORKER_TICK=1s
MEETING_OUTBOX_BATCH=50
MEETING_WEBHOOK_BATCH=50
MEETING_WEBHOOK_CONCURRENCY=8
# Optional room recording bucket (same CMC/S3 creds as STORAGE unless overridden).
LIVEKIT_RECORDING_BUCKET=
LIVEKIT_RECORDING_S3_ENDPOINT=

# ==================== Auth / OAuth (non-secret) ====================
# GOOGLE_CLIENT_SECRET → Secret uniwork-google. Empty ID hides Google login.
GOOGLE_CLIENT_ID=591833832116-q2adltpifhtkeu9etg7h2c8v1sp1uciq.apps.googleusercontent.com
# Six-digit only; ignored when APP_ENV=production.
DEV_VERIFICATION_CODE=

# ==================== Desktop auth (Office desktop, public PKCE client) ====================
# No secret: the client is public. Redirects are an exact allowlist; adjust the
# placeholders below to the deployed desktop build before enabling desktop sign-in.
DESKTOP_AUTH_CLIENT_ID=uniwork-office
DESKTOP_AUTH_REDIRECT_URIS=uniwork-office://auth/callback
DESKTOP_AUTH_DEPLOYMENT_IDS=default
DESKTOP_AUTH_CODE_TTL=120s
DESKTOP_AUTH_ATTEMPT_TTL=10m

# ==================== Billing ====================
BILLING_PROVIDER=manual

# ==================== Push (Web Push / VAPID) ====================
# Private key → Secret. Both keys empty turns push off.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:noreply@unicomhub.com

# ==================== Chat / misc ====================
# Empty = built-in GIF catalog.
TENOR_API_KEY=
ADMIN_RATE_LIMIT_PER_MIN=60
RUM_SAMPLE_RATE=0.2

# ==================== AI (optional) ====================
# Provider keys → Secret. AI_PROVIDER empty/off disables copilot features.
# OPENAI_API_KEY (OpenRouter sk-or-v1-…) and ANTHROPIC_API_KEY → Kubernetes Secret only.
AI_PROVIDER=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_TIMEOUT_SECONDS=60
ANTHROPIC_MODEL=
# OpenRouter model slugs (see openrouter.ai/models). Extend allowlist if you add models:
AI_MODEL_ALLOW=openai/gpt-4o-mini,openai/gpt-4o
AI_MODEL_MEETING_SUMMARIZATION=openai/gpt-4o-mini
AI_MODEL_EMAIL_THREAD_SUMMARY=openai/gpt-4o-mini
AI_MODEL_COPILOT_ANSWER=openai/gpt-4o-mini
AI_MODEL_CHAT_CATCHUP=openai/gpt-4o-mini

# ==================== Observability ====================
# Prometheus listener, separate from PORT so /metrics never reaches the edge.
# The port must match be.metricsPort in deploy/app/uniwork/values.yaml.
METRICS_ADDR=0.0.0.0:9090
# Empty = no exporter: trace ids (X-Trace-Id, correlation_id) are still minted,
# but no span is recorded.
OTEL_SERVICE_NAME=uniwork-be
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=

# ==================== Office engine (BE client) ====================
# Keep OFFICE_ENGINE_URL EMPTY here — the chart sets it to
# http://uniwork-office-engine:<port> (officeEngine.enabled=true).
# Timeouts / job knobs below are BE-side (ConfigMap uniwork-be).
# Engine listen/origins/workers: deploy/app/env/uniwork-office-engine.env
# SERVICE_TOKEN / GRANT_KEY: Secret uniwork-office-engine (never commit here).
OFFICE_ENGINE_URL=
OFFICE_ENGINE_REQUEST_TIMEOUT_MS=10000
OFFICE_JOB_MAX_DEADLINE_MS=120000
OFFICE_JOB_RECONCILE_INTERVAL_MS=5000
# Desktop installer download picker (JSON map platform -> HTTPS URL, see
# .env.example). Empty = the channel shows as unavailable. Fill from the
# installer workflow's run summary (OFFICE_INSTALLER_<CHANNEL>_URLS).
OFFICE_INSTALLER_DEV_URLS=
OFFICE_INSTALLER_BETA_URLS=
OFFICE_INSTALLER_STABLE_URLS=

# ==================== Feature flags ====================
# Defaults live in server/internal/featureflags/keys.go: documents and
# office_engine are OFF, each office_<format> flag is ON. Prefer per-organization
# overrides in /admin; FF_<KEY>=true|false here is the environment-wide switch
# (and "false" is the kill switch). Office needs BOTH documents and office_engine
# on; the engine itself is always deployed with the release.
# FF_DOCUMENTS=true
# FF_OFFICE_ENGINE=true
