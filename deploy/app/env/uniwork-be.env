# UniWork BE — non-secret production runtime (K8s ConfigMap via Helm --set-file).
# Secrets stay in Kubernetes Secrets (DATABASE_URL, REDIS_URL, JWT_SECRET,
# LIVEKIT_API_*, SMTP_PASSWORD, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, …).
# Pattern matches REAP deploy/app/env/*.env.

# ==================== Server ====================
PORT=8080
APP_ENV=production
LOG_LEVEL=info
ENABLE_SWAGGER=false
# Comma-separated CIDRs that may set X-Forwarded-For (Calico pod CIDR on REAP).
TRUSTED_PROXIES=10.244.0.0/16

# ==================== Public origins ====================
# Browser origin for the web app (CORS + Secure cookies when https).
FRONTEND_ORIGIN=https://uniwork.unicomhub.com
# Extra WebSocket Origins beyond FRONTEND_ORIGIN (comma-separated). Empty = only FRONTEND_ORIGIN.
ALLOWED_ORIGINS=
# Origin browsers use to reach this API (Google OAuth redirect is built from this).
API_PUBLIC_URL=https://uniwork.unicomhub.com

# ==================== Mail (SMTP) ====================
# Password: Secret uniwork-mail key SMTP_PASSWORD (never commit here).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=contact@unicomhub.com
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=UniWork
MAIL_FROM=UniWork <noreply@unicomhub.com>

# ==================== Storage (CMC S3-compatible) ====================
# Flip to s3 after Secret uniwork-s3 exists (see runbook).
STORAGE_BACKEND=s3
LOCAL_UPLOAD_DIR=/tmp/uploads
# CMC Object Storage (S3 API). Keys → Secret uniwork-s3.
S3_BUCKET=uniwork
S3_REGION=hn-2
AWS_ENDPOINT_URL=https://s3.hn-2.cloud.cmctelecom.vn
# Path-style is required for most S3-compatible endpoints (CMC/MinIO).
S3_USE_PATH_STYLE=true
# Root folder inside the bucket: production/ (this cluster) or dev/ (local/staging).
S3_KEY_PREFIX=production/
# Optional public CDN / custom domain for returned object URLs.
CLOUDFRONT_DOMAIN=

# ==================== LiveKit (non-secret) ====================
# API key/secret → Secret uniwork-livekit.
LIVEKIT_URL=wss://livekit.vn247.info:7880
MEETING_PROVIDER=livekit
LIVEKIT_TOKEN_TTL=30m
LIVEKIT_ROOM_EMPTY_TIMEOUT=
LIVEKIT_ROOM_DEPARTURE_TIMEOUT=20s
MEETING_WORKER_TICK=1s
MEETING_OUTBOX_BATCH=50
MEETING_WEBHOOK_BATCH=50
MEETING_WEBHOOK_CONCURRENCY=8
# Optional room recording bucket (same CMC/S3 creds as STORAGE unless overridden).
LIVEKIT_RECORDING_BUCKET=
LIVEKIT_RECORDING_S3_ENDPOINT=

# ==================== Auth / OAuth (non-secret) ====================
# GOOGLE_CLIENT_SECRET → Secret. Leave ID empty to hide Google login.
GOOGLE_CLIENT_ID=
# Six-digit only; ignored when APP_ENV=production.
DEV_VERIFICATION_CODE=

# ==================== Billing ====================
BILLING_PROVIDER=manual

# ==================== Push (Web Push / VAPID) ====================
# Private key → Secret. Both keys empty turns push off.
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:noreply@unicomhub.com

# ==================== Chat / misc ====================
# Empty = built-in GIF catalog.
TENOR_API_KEY=
ADMIN_RATE_LIMIT_PER_MIN=60
RUM_SAMPLE_RATE=0.2

# ==================== AI (optional) ====================
# Provider keys → Secret. AI_PROVIDER empty/off disables copilot features.
AI_PROVIDER=
AI_TIMEOUT_SECONDS=30
ANTHROPIC_MODEL=
# Optional model overrides: AI_MODEL_COPILOT_ANSWER, AI_MODEL_MEETING_SUMMARIZATION, …

# ==================== Observability (optional) ====================
OTEL_SERVICE_NAME=uniwork-be
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_ARG=
