# UniWork FE — non-secret runtime (K8s ConfigMap via Helm --set-file).
# NEXT_PUBLIC_* are build-args in Jenkins (baked into the image), not runtime.

# Corepack/pnpm cache for non-root (uid 1001). New images also bake
# `corepack prepare` + HOME=/tmp in the Dockerfile; keep these for older digests.
HOME=/tmp
COREPACK_HOME=/tmp/corepack
XDG_CACHE_HOME=/tmp/cache

# UniChat mobile universal links (apps/web/platform/well-known.ts): Apple Team ID and the
# SHA-256 of the Play App Signing key (Play Console › Protected by Play › App signing).
UNICHAT_IOS_TEAM_ID=XJAM488A6D
UNICHAT_ANDROID_SHA256=AA:A6:FA:C7:52:E6:2F:15:C8:A4:2F:71:C0:83:09:77:4C:C9:AE:B9:BE:8A:7F:FF:10:3B:8D:D6:EF:5B:A1:38
