$ cd server; test -z "$(gofmt -l internal pkg cmd migrations)"; f=$?; gofmt -l internal pkg cmd migrations | head; go vet ./internal/service/... ./internal/handler/... ./internal/ai/... ./cmd/server/ > /tmp/b5-vet.log 2>&1; rc=$?; go tool staticcheck ./internal/service/... ./internal/handler/... ./internal/ai/... ./cmd/server/ >> /tmp/b5-vet.log 2>&1; rc2=$?; tail -20 /tmp/b5-vet.log; echo; echo "GOFMT_EXIT=$f VET_EXIT=$rc STATICCHECK_EXIT=$rc2"; [ "$f" -eq 0 ] && [ "$rc" -eq 0 ] && [ "$rc2" -eq 0 ]

GOFMT_EXIT=0 VET_EXIT=0 STATICCHECK_EXIT=0
