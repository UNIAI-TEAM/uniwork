$ pnpm --filter @uniwork/web typecheck 2>&1 | tail -30; echo "AFTER_WEB_TYPECHECK_EXIT=${PIPESTATUS[0]}"; pnpm --filter @uniwork/core typecheck 2>&1 | tail -20; echo "AFTER_CORE_TYPECHECK_EXIT=${PIPESTATUS[0]}"; true

