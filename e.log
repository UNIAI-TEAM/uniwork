$ cd server; test -z "$(gofmt -l internal pkg cmd)"; f=$?; gofmt -l internal pkg cmd | head; go vet ./internal/office/... ./internal/service/ > /tmp/dg-vet.log 2>&1; rc=$?; go tool staticcheck ./internal/office/... ./internal/service/ >> /tmp/dg-vet.log 2>&1; rc2=$?; tail -20 /tmp/dg-vet.log; echo; echo "GOFMT_EXIT=$f VET_EXIT=$rc STATICCHECK_EXIT=$rc2"

