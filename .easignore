# GENERATED by scripts/mobile-easignore.mjs from every tracked .gitignore: do not edit.
# EAS reads this instead of the .gitignore files (https://expo.fyi/eas-build-archive);
# change a .gitignore (or EAS_ONLY in the script) and run the script again.

# --- .gitignore
node_modules/
.next/
dist/
.turbo/
*.tsbuildinfo
.env
scripts/uniai-sync/config.json
scripts/uniai-sync/.sync.lock
*.local
server/bin/
# Ad-hoc builds land beside the source on Windows; `make` never produces these.
*.exe
coverage/
.go-cache/
.go-tmp/
.changelog-ci/
test-results/
playwright-report/

# G7-01 app harness run artifacts (scripts/office/g5g6g7/harness)
.harness-run/

# G7-06 regression job artifacts (scripts/office/g5g6g7/g7-06)
.g7-06-run/

multica/

# local upload storage (LOCAL_UPLOAD_DIR default)
server/data/
data/uploads/**
!data/uploads/**/
!data/uploads/**/.keep
.env.worktree

# OS / editor noise
.DS_Store
.vscode/
.idea/
.cursor/
.wsl-*.sh
*.pid

# generated by `next dev` (block nextjs-agent-rules) — root CLAUDE.md/AGENTS.md is the source of truth
apps/web/AGENTS.md
apps/web/CLAUDE.md

# stray upload dir when LOCAL_UPLOAD_DIR is resolved relative to a test's cwd
server/internal/handler/data/
.superpowers/
.worktrees/

# per-user Claude Code overrides; the shared hooks live in .claude/settings.json
.claude/settings.local.json

# Impeccable critique snapshots (local design-review archive)
.impeccable/

.agents/
.claude/
.github/
# Public release automation is source, while other local GitHub artifacts stay ignored.
!.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/changelog.yml
!.github/workflows/mobile-verify.yml
!.github/workflows/chat-desktop-release.yml
!.github/workflows/chat-mobile-release.yml
!.github/workflows/chat-mobile-verify.yml
!.github/workflows/meeting-agent-verify.yml
!.github/workflows/meeting-scribe-nightly.yml
!.github/workflows/chat-mobile-update.yml
!.github/workflows/chat-mobile-production.yml
!.github/workflows/chat-mobile-promote.yml
!.github/workflows/chat-mobile-release-health.yml
!.github/workflows/chat-mobile-rollback.yml
!.github/workflows/chat-mobile-device-farm.yml
!.github/workflows/chat-mobile-store-screenshots.yml
!.github/workflows/chat-mobile-tls-pins.yml
.codex/
.pnpm-store/
.uniwork-dev/
.uniwork-dev-run/

# genoffice Docs web build synced by apps/web/scripts/office-frame-sync.mjs (the pin is checked in, the bundle is not)
apps/web/public/office-frame/

# Written by ci/Jenkinsfile.app-dev.groovy on the deploy host.
deploy/app-dev/env/image.env

# EAS Update code-signing private keys (expo-updates codesigning:generate):
# only the certificate (apps/chat-mobile/certs/) is committed, never a key.
private-key.pem
public-key.pem

# --- .codegraph/.gitignore
# CodeGraph data files — local to each machine, not for committing.
# Ignore everything in .codegraph/ except this file itself, so transient
# files (the database, daemon.pid, sockets, logs) never show up in git.
.codegraph/**/*
!.codegraph/**/.gitignore

# --- apps/chat-mobile/.gitignore
# Expo prebuild output and caches; app.config.ts is the source. Anchored to
# the app's root: modules/*/android and modules/*/ios are the local Expo
# modules' own sources and are committed (native-modules.test.ts).
apps/chat-mobile/ios/
apps/chat-mobile/android/
# What Gradle builds of a local module (its sources stay committed).
apps/chat-mobile/modules/*/android/build/
apps/chat-mobile/**/.expo/
apps/chat-mobile/**/dist/
apps/chat-mobile/**/expo-env.d.ts

# --- apps/meeting-agent/.gitignore
apps/meeting-agent/**/.venv/
apps/meeting-agent/**/__pycache__/
apps/meeting-agent/**/.pytest_cache/
apps/meeting-agent/**/.ruff_cache/

# --- apps/meeting-agent/eval/.gitignore
# The golden set is personal data (voices, names): it never enters git.
apps/meeting-agent/eval/**/data/
apps/meeting-agent/eval/**/out/

# --- packages/office-upstream/upstream/packages/pdf2docx/.gitignore
packages/office-upstream/upstream/packages/pdf2docx/ocr-helper/vision-ocr
packages/office-upstream/upstream/packages/pdf2docx/ocr-helper/vision-ocr.arm64
packages/office-upstream/upstream/packages/pdf2docx/ocr-helper/vision-ocr.x86_64
packages/office-upstream/upstream/packages/pdf2docx/ocr-helper/win-ocr.exe

# --- reports/shortcuts_local/raw/.gitignore
# Raw Microsoft help pages stay local: they embed public MS telemetry keys that
# gitleaks flags. Refetch from the URLs in ms-fetch-log.tsv / ms-fetch-web-log.tsv.
reports/shortcuts_local/raw/**/ms-html/
reports/shortcuts_local/raw/**/ms-html-web/
# Library sources checked out for the inventory (157 MB, nested .git).
reports/shortcuts_local/raw/**/lib-src/

# --- EAS only: the CodeGraph index (its .gitignore keeps itself in git) holds a live daemon socket the archive cannot copy.
.codegraph/
