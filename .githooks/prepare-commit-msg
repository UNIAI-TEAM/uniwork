#!/usr/bin/env bash
# Adds a `Refs: UNI-nnn` trailer taken from the branch name, so every commit on
# an issue branch links back to UniAI without anyone typing the key.
# Rules: docs/engineering/UNIAI_TRACKING.md § 3. Never rejects a commit.
set -euo pipefail

msg_file="$1"; source="${2:-}"

# Merges, squashes and rebases carry their own message; leave them alone.
case "$source" in merge|squash|commit) exit 0 ;; esac

branch="$(git branch --show-current 2>/dev/null || true)"
key="$(printf '%s' "$branch" | grep -oE 'UNI-[0-9]+' | head -n1 || true)"
[ -n "$key" ] || exit 0

grep -qE "^Refs: $key\b" "$msg_file" && exit 0

# Append after the message, keeping any comment lines git added at the end.
# Pure awk (no python3): Git for Windows ships awk but not python3.
tmp="$msg_file.refs.$$"
awk -v key="$key" '
  !incomments && /^#/ { incomments = 1 }
  incomments { comments[++nc] = $0; next }
  { body[++nb] = $0 }
  END {
    while (nb > 0 && body[nb] ~ /^[ \t\r]*$/) nb--
    for (i = 1; i <= nb; i++) print body[i]
    print ""
    print "Refs: " key
    if (nc > 0) print ""
    for (i = 1; i <= nc; i++) print comments[i]
  }
' "$msg_file" > "$tmp"
mv "$tmp" "$msg_file"
