{
  "description": "Shared page-JSON sanitize contract (C-01 §3.7; UNI-675). The Go sanitizer (server/internal/document) and the TypeScript mirror (packages/core/documents/schema.ts) must produce identical results for every case. `input` is a JSON document fed through the sanitizer; `input_json` is a raw string for cases that must fail before parsing. `options` overrides `defaults` per key. `expect.error` asserts the error code; otherwise `expect.content` is deep-compared against the sanitized document and `expect.text` against the extracted content_text.",
  "defaults": {
    "maxInputBytes": 8388608,
    "maxBytes": 2097152,
    "maxDepth": 50,
    "maxNodes": 50000,
    "maxTableRows": 200,
    "maxTableCols": 20
  },
  "cases": [
    {
      "name": "empty-doc",
      "input": { "type": "doc" },
      "expect": { "content": { "type": "doc", "content": [] }, "text": "" }
    },
    {
      "name": "simple-doc",
      "input": {
        "type": "doc",
        "content": [
          { "type": "heading", "attrs": { "level": 2 }, "content": [ { "type": "text", "text": "Tiêu đề" } ] },
          { "type": "paragraph", "content": [ { "type": "text", "text": "Xin chào", "marks": [ { "type": "bold" } ] } ] }
        ]
      },
      "expect": {
        "content": {
          "type": "doc",
          "content": [
            { "type": "heading", "attrs": { "level": 2 }, "content": [ { "type": "text", "text": "Tiêu đề" } ] },
            { "type": "paragraph", "content": [ { "type": "text", "text": "Xin chào", "marks": [ { "type": "bold" } ] } ] }
          ]
        },
        "text": "Tiêu đề\nXin chào"
      }
    },
    {
      "name": "root-attrs-dropped",
      "input": {
        "type": "doc", "version": 4, "onclick": "steal()",
        "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "a" } ] } ]
      },
      "expect": {
        "content": { "type": "doc", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "a" } ] } ] },
        "text": "a"
      }
    },
    {
      "name": "unknown-nodes-dropped",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [ { "type": "text", "text": "keep" } ] },
          { "type": "script", "attrs": { "src": "https://evil.example/x.js" } },
          { "type": "iframe", "content": [ { "type": "text", "text": "hidden" } ] },
          { "type": "flurb", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "nested" } ] } ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "keep" } ] } ] },
        "text": "keep"
      }
    },
    {
      "name": "unknown-mark-and-attr-dropped",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "attrs": { "align": "center", "onclick": "x" },
            "content": [
              { "type": "text", "text": "hi",
                "marks": [ { "type": "bold" }, { "type": "rainbow" }, { "type": "bold", "attrs": { "evil": 1 } } ] }
            ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph",
            "content": [ { "type": "text", "text": "hi", "marks": [ { "type": "bold" }, { "type": "bold" } ] } ] }
        ] },
        "text": "hi"
      }
    },
    {
      "name": "link-hrefs",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "text", "text": "a", "marks": [ { "type": "link", "attrs": { "href": "https://uniwork.example/docs" } } ] },
            { "type": "text", "text": "b", "marks": [ { "type": "link", "attrs": { "href": "mailto:a@b.c" } } ] },
            { "type": "text", "text": "c", "marks": [ { "type": "link", "attrs": { "href": "/docs/123" } } ] },
            { "type": "text", "text": "d", "marks": [ { "type": "link", "attrs": { "href": "javascript:alert(1)" } } ] },
            { "type": "text", "text": "e", "marks": [ { "type": "link", "attrs": { "href": "data:text/html,x" } } ] },
            { "type": "text", "text": "f", "marks": [ { "type": "link", "attrs": { "href": "//evil.example" } } ] },
            { "type": "text", "text": "g", "marks": [ { "type": "link", "attrs": { "href": "http://plain.example" } } ] },
            { "type": "text", "text": "h", "marks": [ { "type": "link", "attrs": { "href": "https://a b/c" } } ] },
            { "type": "text", "text": "i", "marks": [ { "type": "link" } ] }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "text", "text": "a", "marks": [ { "type": "link", "attrs": { "href": "https://uniwork.example/docs" } } ] },
            { "type": "text", "text": "b", "marks": [ { "type": "link", "attrs": { "href": "mailto:a@b.c" } } ] },
            { "type": "text", "text": "c", "marks": [ { "type": "link", "attrs": { "href": "/docs/123" } } ] },
            { "type": "text", "text": "d" },
            { "type": "text", "text": "e" },
            { "type": "text", "text": "f" },
            { "type": "text", "text": "g" },
            { "type": "text", "text": "h" },
            { "type": "text", "text": "i" }
          ] }
        ] },
        "text": "abcdefghi"
      }
    },
    {
      "name": "images-asset-only",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA", "alt": "chart", "width": 320 } },
            { "type": "image", "attrs": { "src": "https://evil.example/x.png", "alt": "ext" } },
            { "type": "image", "attrs": { "src": "javascript:alert(1)" } },
            { "type": "image", "attrs": { "alt": "no src" } },
            { "type": "image", "attrs": { "src": "asset://short" } }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA", "alt": "chart", "width": 320 } }
          ] }
        ] },
        "text": "chart"
      }
    },
    {
      "name": "mentions",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "mention", "attrs": { "kind": "user", "id": "01JZQ8K0V5M2H3N4P6R8T0W2XA", "label": "@Minh" } },
            { "type": "text", "text": " " },
            { "type": "mention", "attrs": { "kind": "channel", "id": "01JZQ8K0V5M2H3N4P6R8T0W2XA", "label": "bad kind" } },
            { "type": "mention", "attrs": { "kind": "task", "id": "not-a-ulid", "label": "bad id" } },
            { "type": "mention", "attrs": { "kind": "task", "label": "no id" } },
            { "type": "mention", "attrs": { "kind": "document", "id": "01JZQ8K0V5M2H3N4P6R8T0W2XA" } }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "mention", "attrs": { "kind": "user", "id": "01JZQ8K0V5M2H3N4P6R8T0W2XA", "label": "@Minh" } },
            { "type": "text", "text": " " },
            { "type": "mention", "attrs": { "kind": "document", "id": "01JZQ8K0V5M2H3N4P6R8T0W2XA" } }
          ] }
        ] },
        "text": "@Minh "
      }
    },
    {
      "name": "nested-lists-and-text",
      "input": {
        "type": "doc",
        "content": [
          { "type": "bulletList", "content": [
            { "type": "listItem", "content": [
              { "type": "paragraph", "content": [ { "type": "text", "text": "one" } ] },
              { "type": "bulletList", "content": [
                { "type": "listItem", "content": [
                  { "type": "paragraph", "content": [ { "type": "text", "text": "two" } ] }
                ] }
              ] }
            ] }
          ] },
          { "type": "orderedList", "attrs": { "start": 5 }, "content": [
            { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "three" } ] } ] }
          ] },
          { "type": "orderedList", "attrs": { "start": "x" }, "content": [
            { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "four" } ] } ] }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "bulletList", "content": [
            { "type": "listItem", "content": [
              { "type": "paragraph", "content": [ { "type": "text", "text": "one" } ] },
              { "type": "bulletList", "content": [
                { "type": "listItem", "content": [
                  { "type": "paragraph", "content": [ { "type": "text", "text": "two" } ] }
                ] }
              ] }
            ] }
          ] },
          { "type": "orderedList", "attrs": { "start": 5 }, "content": [
            { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "three" } ] } ] }
          ] },
          { "type": "orderedList", "content": [
            { "type": "listItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "four" } ] } ] }
          ] }
        ] },
        "text": "one\ntwo\nthree\nfour"
      }
    },
    {
      "name": "table-and-cell-attrs",
      "input": {
        "type": "doc",
        "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [
              { "type": "tableHeader", "attrs": { "colspan": 2 }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "H" } ] } ] }
            ] },
            { "type": "tableRow", "content": [
              { "type": "tableCell", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "A" } ] } ] },
              { "type": "tableCell", "attrs": { "colspan": 0 }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "B" } ] } ] }
            ] }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [
              { "type": "tableHeader", "attrs": { "colspan": 2 }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "H" } ] } ] }
            ] },
            { "type": "tableRow", "content": [
              { "type": "tableCell", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "A" } ] } ] },
              { "type": "tableCell", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "B" } ] } ] }
            ] }
          ] }
        ] },
        "text": "H\nA\nB"
      }
    },
    {
      "name": "task-items-and-breaks",
      "input": {
        "type": "doc",
        "content": [
          { "type": "taskList", "content": [
            { "type": "taskItem", "attrs": { "checked": true }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "done" } ] } ] },
            { "type": "taskItem", "attrs": { "checked": false }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "todo" } ] } ] },
            { "type": "taskItem", "attrs": { "checked": "yes" }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "bad" } ] } ] }
          ] },
          { "type": "paragraph", "content": [
            { "type": "text", "text": "line1" },
            { "type": "hardBreak" },
            { "type": "text", "text": "line2" },
            { "type": "hardBreak", "attrs": { "x": 1 } }
          ] },
          { "type": "horizontalRule" },
          { "type": "blockquote", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "quoted" } ] } ] },
          { "type": "codeBlock", "attrs": { "language": "go" }, "content": [ { "type": "text", "text": "fmt.Println()" } ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "taskList", "content": [
            { "type": "taskItem", "attrs": { "checked": true }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "done" } ] } ] },
            { "type": "taskItem", "attrs": { "checked": false }, "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "todo" } ] } ] },
            { "type": "taskItem", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "bad" } ] } ] }
          ] },
          { "type": "paragraph", "content": [
            { "type": "text", "text": "line1" },
            { "type": "hardBreak" },
            { "type": "text", "text": "line2" },
            { "type": "hardBreak" }
          ] },
          { "type": "horizontalRule" },
          { "type": "blockquote", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "quoted" } ] } ] },
          { "type": "codeBlock", "attrs": { "language": "go" }, "content": [ { "type": "text", "text": "fmt.Println()" } ] }
        ] },
        "text": "done\ntodo\nbad\nline1\nline2\n\nquoted\nfmt.Println()"
      }
    },
    {
      "name": "heading-level-validation",
      "input": {
        "type": "doc",
        "content": [
          { "type": "heading", "attrs": { "level": 3 }, "content": [ { "type": "text", "text": "ok" } ] },
          { "type": "heading", "attrs": { "level": 4 }, "content": [ { "type": "text", "text": "too deep" } ] },
          { "type": "heading", "attrs": { "level": "2" }, "content": [ { "type": "text", "text": "string" } ] },
          { "type": "heading", "content": [ { "type": "text", "text": "missing" } ] },
          { "type": "heading", "attrs": { "level": 2.5 }, "content": [ { "type": "text", "text": "float" } ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "heading", "attrs": { "level": 3 }, "content": [ { "type": "text", "text": "ok" } ] }
        ] },
        "text": "ok"
      }
    },
    {
      "name": "leaf-content-stripped",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA" },
              "content": [ { "type": "text", "text": "injected" } ] },
            { "type": "hardBreak", "content": [ { "type": "text", "text": "x" } ] }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA" } },
            { "type": "hardBreak" }
          ] }
        ] },
        "text": "\n"
      }
    },
    {
      "name": "attr-value-caps",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": {
              "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA",
              "alt": "",
              "width": 0 } },
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA", "width": -5 } }
          ] },
          { "type": "codeBlock", "attrs": { "language": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "content": [ { "type": "text", "text": "x" } ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA" } },
            { "type": "image", "attrs": { "src": "asset://01JZQ8K0V5M2H3N4P6R8T0W2XA" } }
          ] },
          { "type": "codeBlock", "content": [ { "type": "text", "text": "x" } ] }
        ] },
        "text": "x"
      }
    },
    {
      "name": "text-node-without-text",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "text" },
            { "type": "text", "text": 5 },
            { "type": "text", "text": "kept" }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [ { "type": "text", "text": "kept" } ] }
        ] },
        "text": "kept"
      }
    },
    {
      "name": "malformed-json",
      "input_json": "{not json",
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "root-not-doc",
      "input": { "type": "paragraph", "content": [ { "type": "text", "text": "hi" } ] },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "root-scalar",
      "input_json": "\"hello\"",
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "root-content-not-array",
      "input": { "type": "doc", "content": "nope" },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "node-not-object",
      "input": { "type": "doc", "content": [ "stray", 42, { "type": "paragraph", "content": [ { "type": "text", "text": "ok" } ] } ] },
      "expect": {
        "content": { "type": "doc", "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "ok" } ] } ] },
        "text": "ok"
      }
    },
    {
      "name": "depth-exceeded",
      "input_json": "{\"type\":\"doc\",\"content\":[{\"type\":\"blockquote\",\"content\":[{\"type\":\"blockquote\",\"content\":[{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"deep\"}]}]}]}]}]}",
      "options": { "maxDepth": 3 },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "node-count-exceeded",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [ { "type": "text", "text": "a" } ] },
          { "type": "paragraph", "content": [ { "type": "text", "text": "b" } ] }
        ]
      },
      "options": { "maxNodes": 4 },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "sanitized-oversize",
      "input": {
        "type": "doc",
        "content": [ { "type": "paragraph", "content": [ { "type": "text", "text": "this is definitely longer than sixty four bytes of sanitized content output" } ] } ]
      },
      "options": { "maxBytes": 64 },
      "expect": { "error": "document_too_large" }
    },
    {
      "name": "input-oversize",
      "input_json": "{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"a\"}]}]}",
      "options": { "maxInputBytes": 16 },
      "expect": { "error": "document_too_large" }
    },
    {
      "name": "table-limits",
      "input": {
        "type": "doc",
        "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "a" } ] } ] },
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "b" } ] } ] }
          ] }
        ]
      },
      "options": { "maxTableRows": 1 },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "table-col-limit",
      "input": {
        "type": "doc",
        "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [
              { "type": "tableCell", "content": [ { "type": "text", "text": "a" } ] },
              { "type": "tableCell", "content": [ { "type": "text", "text": "b" } ] }
            ] }
          ] }
        ]
      },
      "options": { "maxTableCols": 1 },
      "expect": { "error": "document_invalid" }
    },
    {
      "name": "table-rows-boundary-ok",
      "input": {
        "type": "doc",
        "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "a" } ] } ] },
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "b" } ] } ] }
          ] }
        ]
      },
      "options": { "maxTableRows": 2 },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "table", "content": [
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "a" } ] } ] },
            { "type": "tableRow", "content": [ { "type": "tableCell", "content": [ { "type": "text", "text": "b" } ] } ] }
          ] }
        ] },
        "text": "a\nb"
      }
    },
    {
      "name": "link-backslash-bypass",
      "input": {
        "type": "doc",
        "content": [
          { "type": "paragraph", "content": [
            { "type": "text", "text": "a", "marks": [ { "type": "link", "attrs": { "href": "/\\evil.example" } } ] },
            { "type": "text", "text": "b", "marks": [ { "type": "link", "attrs": { "href": "https:\\\\evil.example" } } ] },
            { "type": "text", "text": "c", "marks": [ { "type": "link", "attrs": { "href": "https://ok.example" } } ] }
          ] }
        ]
      },
      "expect": {
        "content": { "type": "doc", "content": [
          { "type": "paragraph", "content": [
            { "type": "text", "text": "a" },
            { "type": "text", "text": "b" },
            { "type": "text", "text": "c", "marks": [ { "type": "link", "attrs": { "href": "https://ok.example" } } ] }
          ] }
        ] },
        "text": "abc"
      }
    },
    {
      "name": "link-control-and-unicode-space",
      "input": {
        "type": "doc",
        "content": [
