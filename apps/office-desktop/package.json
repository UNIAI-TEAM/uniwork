{
  "name": "@uniwork/office-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UniWork Office unsigned development desktop host. Electron is an adapter around the shared Office engine and contracts.",
  "homepage": "https://uniwork.unicomhub.com",
  "main": "dist/main/index.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "package:linux": "node scripts/package.mjs --platform linux",
    "package:linux:docker": "node scripts/package-linux-docker.mjs",
    "package:macos": "node scripts/package.mjs --platform darwin",
    "smoke": "node scripts/launch-smoke.mjs",
    "smoke:recovery-system": "node scripts/draft-system-smoke.mjs",
    "smoke:installer": "node scripts/installer-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests=false --coverage && node --test scripts/package.test.mjs scripts/release-inventory.test.mjs scripts/check-xlsx-assets.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/plus-jakarta-sans": "catalog:",
    "@uniwork/core": "workspace:*",
    "@uniwork/office-contracts": "workspace:*",
    "@uniwork/office-engine": "workspace:*",
    "@uniwork/office-upstream": "workspace:*",
    "@uniwork/views": "workspace:*",
    "@uniwork/ui": "workspace:*",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@uniwork/eslint-config": "workspace:*",
    "@uniwork/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "eslint": "^9.32.0",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
