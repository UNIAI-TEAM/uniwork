{
  "name": "@uniwork/office-engine-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "UniWork Office engine service host. G2-02 owns the real service; this scaffold binds the contract-shaped Node transport behind an injected endpoint and refuses to serve until one is configured.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests=false --coverage",
    "lint": "eslint . --max-warnings 0"
  },
