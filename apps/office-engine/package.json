    ".": "./src/index.ts"
  },
  "dependencies": {
    "@uniwork/office-contracts": "workspace:*",
    "@uniwork/office-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uniwork/eslint-config": "workspace:*",
    "@uniwork/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.32.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
