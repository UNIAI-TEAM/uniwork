{
  "name": "@uniwork/chat-desktop",
  "version": "0.0.0",
  "private": true,
  "description": "UniChat desktop shell: an Electron window around the UniWork web app's chat layout",
  "author": { "name": "UniWork", "email": "dev@uniworkos.com" },
  "homepage": "https://uniworkos.com",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests=false --coverage"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@uniwork/core": "workspace:*",
    "@uniwork/eslint-config": "workspace:*",
    "@uniwork/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "eslint": "^9.32.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
