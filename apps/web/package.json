{
  "name": "@uniwork/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdfium-wasm.mjs && node scripts/office-frame-sync.mjs --ensure && sh -c 'next dev --port \"${FRONTEND_PORT:-3000}\"'",
    "build": "node scripts/copy-pdfium-wasm.mjs && node scripts/office-frame-sync.mjs --ensure && next build",
    "start": "next start",
    "office-frame:sync": "node scripts/office-frame-sync.mjs",
    "office-frame:check": "node scripts/office-frame-sync.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests=false --coverage"
  },
  "dependencies": {
    "@gsap/react": "catalog:",
    "@uniwork/core": "workspace:*",
    "@uniwork/office-contracts": "workspace:*",
    "@uniwork/office-engine": "workspace:*",
    "@uniwork/office-upstream": "workspace:*",
    "@uniwork/ui": "workspace:*",
    "@uniwork/views": "workspace:*",
    "gsap": "catalog:",
    "lucide-react": "catalog:",
    "next": "^16.3.8",
    "parse5": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "three": "catalog:",
    "web-vitals": "^6.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@embedpdf/pdfium": "catalog:",
    "@types/three": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@uniwork/eslint-config": "workspace:*",
    "@uniwork/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "^9.32.0",
    "jsdom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
