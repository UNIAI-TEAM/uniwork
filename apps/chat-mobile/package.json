{
  "name": "@uniwork/chat-mobile",
  "version": "0.3.0",
  "private": true,
  "description": "UniChat mobile app: Expo (iOS + Android) client of the UniWork chat",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "ios": "bash scripts/native-run.sh ios",
    "android": "bash scripts/native-run.sh android",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:components && bash scripts/native-run.test.sh",
    "test:unit": "vitest run --passWithNoTests=false --coverage",
    "test:components": "jest --ci --coverage"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    },
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-notifications"
        ]
      },
      "ios": {
        "exclude": [
          "@expo/ui",
          "@expo/dom-webview",
          "expo-symbols"
        ]
      }
    }
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-persist-client-core": "5.102.3",
    "@tanstack/react-query": "catalog:",
    "@uniwork/core": "workspace:*",
    "babel-preset-expo": "~57.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.31",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-screen-capture": "~57.0.4",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "i18next": "catalog:",
    "livekit-client": "^2.21.0",
    "nativewind": "^4.1.23",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
