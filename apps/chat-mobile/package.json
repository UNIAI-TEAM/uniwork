{
  "name": "@uniwork/chat-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "UniChat mobile app: Expo (iOS + Android) client of the UniWork chat",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "ios": "bash scripts/native-run.sh ios",
    "android": "bash scripts/native-run.sh android",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests=false --coverage && bash scripts/native-run.test.sh"
  },
  "expo": {
    "install": {
      "exclude": ["typescript"]
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/radio-group": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/switch": "^1.4.0",
    "@tanstack/react-query": "catalog:",
    "@uniwork/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "catalog:",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "i18next": "catalog:",
    "nativewind": "^4.1.23",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-i18next": "catalog:",
    "react-native": "catalog:",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@uniwork/eslint-config": "workspace:*",
    "@uniwork/tsconfig": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.32.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
