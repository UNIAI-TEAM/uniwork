# Expo prebuild output and caches; app.config.ts is the source. Anchored to
# the app's root: modules/*/android and modules/*/ios are the local Expo
# modules' own sources and are committed (native-modules.test.ts).
/ios/
/android/
# What Gradle builds of a local module (its sources stay committed).
/modules/*/android/build/
.expo/
dist/
expo-env.d.ts
