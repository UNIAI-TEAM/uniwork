{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "pnpm": "10.28.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "env": { "UNICHAT_ENV": "dev", "SENTRY_ALLOW_FAILURE": "true" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": { "UNICHAT_ENV": "staging", "SENTRY_ALLOW_FAILURE": "true" },
      "android": { "buildType": "apk" }
    },
    "internal": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "internal",
      "environment": "preview",
      "env": { "UNICHAT_ENV": "staging", "SENTRY_ALLOW_FAILURE": "true" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": { "UNICHAT_ENV": "production", "SENTRY_ALLOW_FAILURE": "true" }
    }
  },
  "submit": {
    "internal": {
      "android": { "track": "internal" }
    },
    "production": {
      "android": { "track": "production", "releaseStatus": "draft" }
    }
  }
}
